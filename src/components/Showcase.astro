    .sc-body { margin: -1.7rem .35rem .35rem; padding: .55rem .65rem .65rem; border-radius: .95rem; gap: .22rem; }
    .sc-meta { font-size: .66rem; }
    .sc-meta time, .sc-desc, .sc-tech { display: none; }
