<!-- ============ JS riêng của Showcase ============ -->
<script>
  import gsap from 'gsap';
  import { initFilters } from '../scripts/showcase/filters.js';
  import { initViewer } from '../scripts/showcase/viewer.js';
  import { initCards } from '../scripts/showcase/cards.js';

  const root = document.querySelector('#showcase');
  if (root) {
    const demos = JSON.parse(document.getElementById('sc-data').textContent);
    const grid = root.querySelector('#sc-grid');

    /* 1) Khởi tạo 3 module */
    const filters = initFilters({ demos, root });
    const viewer = initViewer({ demos, getList: () => filters.getVisible() });
    initCards(grid, demos);

    /* 2) Bấm thẻ: mở khung xem (giữ hành vi mặc định nếu bấm Ctrl/Cmd/chuột giữa để mở tab mới) */
    grid.addEventListener('click', (e) => {
      const card = e.target.closest('.sc-card');
      if (!card || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      viewer.open(card.dataset.slug, card);
    });

    /* 3) Ảnh thumbnail: ảnh hiện mặc định; chỉ khi LỖI mới ẩn ảnh để lộ hình giả cửa sổ bên dưới */
    grid.querySelectorAll('.sc-media img').forEach((img) => {
      const fail = () => img.closest('.sc-media').classList.add('no-thumb');
      img.addEventListener('error', fail);
      if (img.complete && !img.naturalWidth) fail();     // đã lỗi trước khi script chạy
    });

    /* 4) Thẻ hiện dần khi cuộn tới */
    const cards = [...grid.querySelectorAll('.sc-card')];
    gsap.set(cards, { opacity: 0, y: 40 });
    new IntersectionObserver(([entry], obs) => {
      if (!entry.isIntersecting) return;
      obs.disconnect();
      gsap.to(cards, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', stagger: 0.06, clearProps: 'transform,opacity' });
    }, { rootMargin: '0px 0px -10% 0px' }).observe(grid);

    /* 5) Mở thẳng demo nếu link có #demo=ten-demo */
    viewer.openFromHash();
  }
</script>