  /* Sân khấu: phủ kín khung xem. Khoảng trống trên/dưới do JS đặt (chừa chỗ cho 2 thanh kính) */
  .sc-stage { position: absolute; inset: 0; z-index: 1; display: grid; place-items: center; padding: 1rem; overflow: hidden; }
  .sc-frame {
    position: relative; overflow: hidden; background: #000; border-radius: 14px;
    box-shadow: 0 40px 100px -30px rgba(0, 0, 0, .8), 0 0 0 1px rgba(255, 255, 255, .1);
