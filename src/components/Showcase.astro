    .sc-card, .sc-tilt { border-radius: 1.25rem; }
    .sc-media { aspect-ratio: 5 / 4; }                                              /* ảnh cao hơn một chút cho dễ nhìn */
    .sc-badges { top: .45rem; left: .45rem; }
