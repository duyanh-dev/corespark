/* Thẻ: bỏ backdrop-filter ở phần tử con, chỉ tăng độ đục nền cho vẫn đọc rõ */
.sc-body  { background: rgba(255, 255, 255, .84); -webkit-backdrop-filter: none; backdrop-filter: none; }
.sc-badge { background: rgba(255, 255, 255, .78); -webkit-backdrop-filter: none; backdrop-filter: none; }
