  .sc-loader.is-done { opacity: 0; pointer-events: none; }
  .sc-spin { position: relative; width: 2rem; height: 2rem; border: 3px solid rgba(255, 255, 255, .22); border-top-color: #fff; border-radius: 50%; animation: sc-rot .8s linear infinite; }
  @keyframes sc-rot { to { transform: rotate(360deg); } }

  /* Thanh kính phía dưới: gợi ý + "Tôi muốn web như này" */
  .sc-vfoot {
    position: absolute; z-index: 3; left: .7rem; right: .7rem; bottom: calc(.7rem + env(safe-area-inset-bottom));
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: .55rem .7rem .55rem 1.2rem; border-radius: 1.6rem;
    background: var(--v-bg); -webkit-backdrop-filter: var(--v-blur); backdrop-filter: var(--v-blur);
    border: 1px solid var(--v-bd); box-shadow: var(--v-shadow);
  }
  .sc-vhint { font-size: .82rem; color: #d1d1d6; }
  .sc-vhint.is-warn { color: #ffd60a; }
  .sc-want { padding: .6rem 1.2rem; border-radius: 999px; background: rgba(255, 255, 255, .92); color: #1d1d1f; font-size: .9rem; font-weight: 600; white-space: nowrap; box-shadow: 0 2px 10px rgba(0, 0, 0, .25); transition: transform .2s; }
  .sc-want:hover { transform: scale(1.04); }

  /* Thông báo nhỏ (vd "Đã sao chép") */
  .sc-toast { position: absolute; left: 50%; bottom: 5.8rem; z-index: 5; padding: .5rem 1rem; border-radius: 999px; background: rgba(255, 255, 255, .92); color: #1d1d1f; font-size: .85rem; font-weight: 600; opacity: 0; pointer-events: none; transform: translate(-50%, 10px); transition: opacity .25s, transform .25s; }
  .sc-toast.is-on { opacity: 1; transform: translate(-50%, 0); }

  /* ---------- 6. RESPONSIVE: chỉ có PC và SP ---------- */

  /* SP (<=1000px, gồm cả máy tính bảng): 1 cột nội dung, THẺ CHIA 2 CỘT, bộ lọc thành ngăn kéo kính từ dưới lên */
  @media (max-width: 1000px) {
    .sc { padding: 6rem 0 5rem; }
    .sc-head { margin-bottom: 2.4rem; }
    .sc-layout { grid-template-columns: minmax(0, 1fr); gap: 0;z-index: auto; }
    .sc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }      /* 2 cột */
    .sc-fbtn { display: inline-flex; }
    .sc-fdone { display: inline; }
    .sc-blob { filter: blur(60px); }

    .sc-filters {
      position: fixed; left: 0; right: 0; bottom: 0; top: auto; z-index: 90; max-height: 86svh;
      padding: 1.2rem var(--gutter) calc(1rem + env(safe-area-inset-bottom));
      border-radius: 1.8rem 1.8rem 0 0; border-bottom: 0;
      background: rgba(255, 255, 255, .78); -webkit-backdrop-filter: blur(30px) saturate(180%); backdrop-filter: blur(30px) saturate(180%);
      box-shadow: 0 -20px 60px rgba(0, 0, 0, .25), inset 0 1px 0 rgba(255, 255, 255, .95);
      transform: translateY(105%); transition: transform .45s cubic-bezier(.2, .8, .2, 1);
    }
    .sc-filters.is-open { transform: none; }
    .sc-apply { display: block; position: sticky; bottom: 0; width: 100%; margin-top: 1rem; padding: .9rem; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-weight: 600; box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 40%, transparent), inset 0 1px 0 rgba(255, 255, 255, .4); }

    .sc-backdrop { display: block; position: fixed; inset: 0; z-index: 85; background: rgba(0, 0, 0, .35); opacity: 0; pointer-events: none; transition: opacity .3s; }
    .sc-backdrop.is-open { opacity: 1; pointer-events: auto; }

    /* Khung xem demo: thanh trên xếp 2 hàng */
    .sc-vbar { grid-template-columns: auto minmax(0, 1fr) auto; grid-template-areas: "close title cta" "dev dev tools"; row-gap: .6rem; }
    .sc-vclose { grid-area: close; }
    .sc-vtitle { grid-area: title; }
    .sc-vcta { grid-area: cta; }
    .sc-seg { grid-area: dev; justify-self: start; }
    .sc-vtools { grid-area: tools; justify-self: end; }
    .sc-vtitle span { display: none; }
  }

  /* Điện thoại: thẻ 2 cột phải GỌN (ẩn mô tả, công nghệ, nút phụ) để vẫn dễ nhìn */
  @media (max-width: 560px) {
    .sc-toolbar { gap: .5rem; }
    .sc-search { flex: 1 1 100%; }
