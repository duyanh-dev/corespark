  }
  .sc-screen { position: absolute; inset: var(--b, 0px); overflow: hidden; background: #fff; transition: inset .55s, border-radius .55s; }
  .sc-screen iframe { position: absolute; left: 0; top: 0; border: 0; background: #fff; transform-origin: 0 0; opacity: 0; transition: opacity .4s; }
  .sc-screen iframe.is-loaded { opacity: 1; }

  /* Màn hình chờ: ảnh thumbnail của demo, phủ lớp kính nhòe + vòng quay */
  .sc-loader { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; background: #1c1c1e var(--thumb, none) center / cover no-repeat; transition: opacity .4s; }
