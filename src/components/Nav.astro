const hasCur = () => sheetItems.find((a) => a.getAttribute('aria-current') === 'true') || null;

/* ===== VIÊN KÍNH =====
   L.y  : vị trí đỉnh viên kính (toạ độ trong .nav__list), L.ty: đích của lò xo, L.vy: vận tốc
   L.k  : độ phồng 0..1 (nhấn giữ = 1). Phồng thì viên kính to ra + chữ bên trong được phóng đại */
const L = { y: 0, ty: 0, vy: 0, k: 0, w: 0, h: 66, on: false };
const PRESS = { sx: .04, sy: .3, m: .2 };   // độ phồng ngang, dọc, và độ phóng đại chữ khi nhấn giữ
let shown = false, hotIdx = -1;

function syncLens() {
  const k = Math.max(-.05, Math.min(1.12, L.k));
  const v = Math.abs(L.vy);
  const stretch = Math.min(.34, v / 1700);
  const sx = 1 + k * PRESS.sx - stretch * .45;
  const sy = 1 + k * PRESS.sy + stretch;
  const m = 1 + k * PRESS.m;
  const w = L.w, h = L.h, cy = L.y + h / 2;
  blob.style.transform = `translate(0px, ${L.y}px) scale(${sx}, ${sy})`;
  blob.style.setProperty('--k', k.toFixed(3));
  blob.style.setProperty('--sh', `${Math.max(-28, Math.min(28, L.vy / 22)).toFixed(1)}deg`);
  mag.style.transform = `translate(${w / 2}px, ${h / 2}px) scale(${m / sx}, ${m / sy}) translate(${-w / 2}px, ${-cy}px)`;

const m2 = m * .86;   // chữ ở mép bị nén vào, như gờ kính
mag2.style.transform = `translate(${w / 2}px, ${h / 2}px) scale(${m2 / sx}, ${m2 / sy}) translate(${-w / 2}px, ${-cy}px)`;

  const half = (h * sy) / 2 - 3;
  rowsEl.style.setProperty('--h0', `${cy - half}px`);
  rowsEl.style.setProperty('--h1', `${cy + half}px`);
  // khúc xạ + tán sắc sống: nhấn giữ hoặc kéo nhanh thì bẻ mạnh hơn
  if (canRefract && dR) {
    const s = 34 + k * 34 + Math.min(46, v * .035);
    if (Math.abs(s - lastS) > .6) {
      lastS = s;
      dR.setAttribute('scale', s.toFixed(1));
      dG.setAttribute('scale', (s * 1.13).toFixed(1));
      dB.setAttribute('scale', (s * 1.26).toFixed(1));
    }
  }
}
function showLens(row) {
  L.on = true; L.ty = row.offsetTop;
  if (!shown) { L.y = L.ty; L.vy = 0; shown = true; blob.style.opacity = '1'; }
  syncLens();
}
function hideLens() {
  gsap.killTweensOf(L);
  L.on = false; L.k = 0; L.vy = 0; shown = false;
  blob.style.opacity = '0';
  rowsEl.style.setProperty('--h0', '-1px'); rowsEl.style.setProperty('--h1', '-1px');
}
function restLens(instant) {
  const cur = hasCur();
  if (!cur) { hideLens(); return; }
  showLens(cur);
  if (instant) { L.y = L.ty; L.vy = 0; syncLens(); }
}

// Giọt kính rơi từ mép trên tấm kính xuống mục hiện tại, kéo giãn rồi nảy
function dropLens() {
  const cur = hasCur();
  if (!cur) return;
  gsap.killTweensOf(L);
  L.on = true; shown = true;
  L.ty = cur.offsetTop;
  L.y = -L.h * 1.1; L.vy = 700; L.k = 1;
  blob.style.opacity = '1';
  syncLens();
  press(false);
}

// Nhấn giữ = phồng lên (lò xo), thả = xẹp về
function press(on, done) {
  gsap.to(L, { k: on ? 1 : 0, duration: on ? .6 : .8, ease: on ? 'elastic.out(1,.55)' : 'elastic.out(1,.65)', overwrite: 'auto', onUpdate: syncLens, onComplete: done });
}
// Lò xo bám theo đích (mỗi khung hình, chỉ chạy khi viên kính đang hiện)
gsap.ticker.add(() => {
  if (!L.on) return;
  const dt = Math.min(.034, gsap.ticker.deltaRatio(60) / 60);
  const dy = L.ty - L.y;
  if (Math.abs(dy) < .04 && Math.abs(L.vy) < .04) {
    if (dy !== 0 || L.vy !== 0) { L.y = L.ty; L.vy = 0; syncLens(); }
    return;
  }
  L.vy += (dy * 320 - L.vy * 15) * dt;
  L.y += L.vy * dt;
  syncLens();
});

// Đo kích thước viên kính (và vẽ bản đồ khúc xạ mép nếu được hỗ trợ)
function buildLensMap() {
  if (!L.w || !L.h) return;
  sheet.classList.add('edge-lite');
  if (!canRefract || !lfilt || !limg) return;
  const r = Math.min(parseFloat(getComputedStyle(sheetItems[0]).borderTopLeftRadius) || 23, L.h / 2);
  lfilt.setAttribute('width', L.w); lfilt.setAttribute('height', L.h);
  limg.setAttribute('width', L.w); limg.setAttribute('height', L.h);
  setHref(limg, drawMap(L.w, L.h, r, Math.min(r, 20)));
  sheet.classList.add('edge-fx');
}
function measureLens() {
  L.w = Math.round(list.offsetWidth);
  L.h = Math.round(sheetItems[0].offsetHeight);
  blob.style.height = `${L.h}px`;
  buildLensMap();
}
new ResizeObserver(() => { if (isOpen) { measureLens(); syncLens(); } }).observe(list);

// Ngón tay kéo: viên kính bám theo, vượt khỏi danh sách thì có lực cản như cao su
const pitch = () => (sheetItems[1] ? sheetItems[1].offsetTop - sheetItems[0].offsetTop : L.h);
function follow(e) {
  const lr = list.getBoundingClientRect();
  const y = e.clientY - lr.top - L.h / 2;
  const lo = sheetItems[0].offsetTop, hi = sheetItems[sheetItems.length - 1].offsetTop;
  L.ty = y < lo ? lo - Math.pow(lo - y, .7) : y > hi ? hi + Math.pow(y - hi, .7) : y;
  const idx = Math.max(0, Math.min(sheetItems.length - 1, Math.round((L.ty - lo) / pitch())));
  if (idx !== hotIdx) { hotIdx = idx; navigator.vibrate?.(5); }   // đi qua mục khác thì rung nhẹ (Android)
}

// Gợn sóng kính tại điểm chạm
function ripple(e) {
  const r = panel.getBoundingClientRect();
  [0, .14].forEach((delay) => {
    const el = document.createElement('span');
    el.className = 'nav__rip';
    el.style.left = `${e.clientX - r.left + panel.scrollLeft}px`;
    el.style.top = `${e.clientY - r.top + panel.scrollTop}px`;
    panel.appendChild(el);
    gsap.fromTo(el, { scale: .1, opacity: delay ? .6 : 1 },
      { scale: 1.35, opacity: 0, duration: 1.1, delay, ease: 'expo.out', onComplete: () => el.remove() });
  });
}

// Chặn hành vi giữ lâu của trình duyệt (xem trước link, menu ngữ cảnh, kéo link, bôi chọn chữ)
panel.addEventListener('contextmenu', (e) => e.preventDefault());
panel.addEventListener('dragstart', (e) => e.preventDefault());
sheetItems.forEach((a) => { a.draggable = false; });

let downRow = null, slid = false;
panel.addEventListener('pointerdown', (e) => {
  touching = true; downRow = rowAt(e); ripple(e);
  if (downRow) { hotIdx = sheetItems.indexOf(downRow); showLens(downRow); press(true); }
});
panel.addEventListener('pointermove', (e) => {
  const r = panel.getBoundingClientRect();
  const px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
  panel.style.setProperty('--mx', `${e.clientX - r.left}px`);
  panel.style.setProperty('--my', `${e.clientY - r.top}px`);
  panel.style.setProperty('--lit', '1');
  let a = (Math.atan2(px - .5, -(py - .5)) * 180) / Math.PI;
  if (a < 0) a += 360;
  panel.style.setProperty('--ang', `${a.toFixed(1)}deg`);
  gsap.to(panel, { rotationY: (px - .5) * 8, rotationX: -(py - .5) * 6, transformPerspective: 900, duration: .5, ease: 'power3.out', overwrite: 'auto' });
  if (touching && downRow) follow(e);
  else if (!touching && e.pointerType === 'mouse') { const row = rowAt(e); if (row) showLens(row); }   // chuột: rê qua thì kính trượt theo, chưa phồng
});
function rest(row) {
  touching = false; hotIdx = -1;
  panel.style.setProperty('--lit', '0');
  gsap.to(panel, { rotationX: 0, rotationY: 0, duration: .8, ease: 'elastic.out(1,.5)', overwrite: 'auto' });
  const target = row || hasCur();
  if (target) { L.ty = target.offsetTop; press(false); }
  else press(false, hideLens);                                // không có mục nào đang xem thì kính xẹp rồi ẩn
}
panel.addEventListener('pointerup', (e) => {
  const was = downRow;
  downRow = null;
  if (!was) { rest(null); return; }          // không bắt đầu từ một mục (vd bấm nút Liên hệ): để click thường lo
  // Mục đích đến = mục mà viên kính đang nằm; thả quá xa khỏi danh sách thì huỷ
  const lr = list.getBoundingClientRect();
  const inside = e.clientY > lr.top - 40 && e.clientY < lr.bottom + 40;
  const row = inside ? (sheetItems[hotIdx] || was) : null;
  rest(row);
  if (row) {
    slid = true; setTimeout(() => (slid = false), 500);   // chặn click thật (nếu có) để khỏi bấm đúp
    activate(row);
  }
});
// Chặn click THẬT do trình duyệt tự sinh ra sau khi mình đã xử lý ở pointerup (bàn phím Enter vẫn chạy bình thường)
panel.addEventListener('click', (e) => {
  if (slid && e.isTrusted && e.target.closest('.nav__item')) { e.preventDefault(); e.stopPropagation(); }
}, true);
panel.addEventListener('pointercancel', () => { downRow = null; rest(); });
panel.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse' && !touching) rest(); });

// Khi không chạm: viền sáng của tấm kính tự xoay chậm cho "sống"
let spin = 315, fr = 0;
gsap.ticker.add(() => {
  if (!isOpen || touching || (++fr & 1)) return;
  spin = (spin + .7) % 360;
  panel.style.setProperty('--ang', `${spin.toFixed(1)}deg`);
});

// Kéo thanh nắm ở đáy lên để đóng (kéo xuống thì có lực cản như cao su)
let gid = null, g0 = 0, gdy = 0;
grab.addEventListener('pointerdown', (e) => { gid = e.pointerId; g0 = e.clientY; gdy = 0; grab.setPointerCapture(gid); gsap.killTweensOf(panel, 'y,scaleY'); });
grab.addEventListener('pointermove', (e) => {
  if (e.pointerId !== gid) return;
  gdy = e.clientY - g0;
  const y = gdy < 0 ? gdy : Math.pow(gdy, .72);
  gsap.set(panel, { y, scaleY: 1 + Math.min(0, gdy) / 900 });
  gsap.set(scrim, { opacity: 1 + Math.min(0, gdy) / 320 });
});
const grabEnd = () => {
  if (gid == null) return;
  gid = null;
  if (gdy < -70) setMenu(false);
  else {
    gsap.to(panel, { y: 0, scaleY: 1, duration: .9, ease: 'elastic.out(1,.5)' });
    gsap.to(scrim, { opacity: 1, duration: .3 });
  }
};
grab.addEventListener('pointerup', grabEnd);
grab.addEventListener('pointercancel', grabEnd);

// Kéo viên thuốc Nav: xuống để mở, lên để đóng. Thanh bị kéo giãn rồi bật lại.
let bid = null, b0 = 0, bOn = false, bdy = 0, barDragged = false;
bar.addEventListener('pointerdown', (e) => {
  if (e.pointerType !== 'touch' || !mobileMQ.matches) return;
  bid = e.pointerId; b0 = e.clientY; bOn = false; bdy = 0;
});
bar.addEventListener('pointermove', (e) => {
  if (e.pointerId !== bid) return;
  const dy = e.clientY - b0;
  if (!bOn && Math.abs(dy) > 8) { bOn = true; bar.setPointerCapture(bid); }
  if (!bOn) return;
  bdy = isOpen ? Math.min(0, dy) : Math.max(0, dy);
  gsap.set(bar, { y: Math.sign(bdy) * Math.pow(Math.abs(bdy), .78), scaleY: 1 + Math.min(Math.abs(bdy), 90) / 380, scaleX: 1 - Math.min(Math.abs(bdy), 90) / 1500 });
});
const barEnd = () => {
  if (bid == null) return;
  bid = null;
  if (bOn) { barDragged = true; setTimeout(() => (barDragged = false), 60); }
  gsap.to(bar, { y: 0, scaleX: 1, scaleY: 1, duration: .9, ease: 'elastic.out(1,.4)' });
  if (bOn && Math.abs(bdy) > 40) setMenu(!isOpen);
  bOn = false;
};
bar.addEventListener('pointerup', barEnd);
bar.addEventListener('pointercancel', barEnd);
bar.addEventListener('click', (e) => { if (barDragged) { e.preventDefault(); e.stopPropagation(); } }, true);

// Điểm xuất phát để tấm kính "mọc ra" từ nút hamburger
function burgerClip() {
  const b = burger.getBoundingClientRect();
  const pl = panel.offsetLeft, pw = panel.offsetWidth, ph = panel.offsetHeight;
  const h = b.height * .9;
  return {
    clip: `inset(0px ${Math.max(0, pl + pw - b.right)}px ${Math.max(0, ph - h)}px ${Math.max(0, b.left - pl)}px round ${h / 2}px)`,
    origin: `${b.left + b.width / 2 - pl}px 0px`,
  };
}

function setMenu(open) {
  if (open === isOpen) return;
  isOpen = open;
  if (open) syncSheetTone();
  burger.classList.toggle('is-open', open);
  burger.setAttribute('aria-expanded', String(open));
  burger.setAttribute('aria-label', open ? 'Đóng menu' : 'Mở menu');
  sheet.setAttribute('aria-hidden', String(!open));
  sheet.inert = !open;
  if (open) window.__lenis?.stop(); else window.__lenis?.start();
  document.documentElement.style.overflow = open ? 'hidden' : '';

  if (tl) tl.kill();
  if (reduce) {
    sheet.classList.toggle('is-open', open);
    gsap.set(scrim, { opacity: open ? 1 : 0 });
    if (open) { measureLens(); restLens(true); } else hideLens();
    return;
  }

  const R = parseFloat(getComputedStyle(panel).borderTopLeftRadius) || 32;
  const full = `inset(0px 0px 0px 0px round ${R}px)`;
  const from = burgerClip();

  if (open) {
    sheet.classList.add('is-open');
    measureLens(); hideLens();
    // màn thấp (xoay ngang) thì cho cuộn dọc, còn lại khoá cử chỉ để trượt/chọn mượt
    panel.style.touchAction = panel.scrollHeight > panel.clientHeight + 1 ? 'pan-y' : 'none';
    tl = gsap.timeline({ onComplete: () => gsap.set(panel, { clearProps: 'clipPath' }) }); // bỏ clip để bóng đổ không bị cắt
    tl.fromTo(panel, { clipPath: from.clip, y: -12, scaleX: .9, scaleY: .88, transformOrigin: from.origin },
                     { clipPath: full, duration: .85, ease: 'expo.out' }, 0)
      .to(panel, { y: 0, scaleX: 1, scaleY: 1, duration: 1.15, ease: 'elastic.out(1,.55)' }, 0)
      .fromTo(bar, { scaleY: .9, scaleX: 1.015 }, { scaleY: 1, scaleX: 1, duration: 1.1, ease: 'elastic.out(1,.4)' }, 0)
      .fromTo(scrim, { opacity: 0 }, { opacity: 1, duration: .45 }, 0)
      .fromTo(kids, { y: 30, opacity: 0, scale: .9, filter: 'blur(10px)' },
              { y: 0, opacity: 1, scale: 1, filter: 'blur(0px)', clearProps: 'filter', duration: .8, ease: 'back.out(1.7)', stagger: .06 }, .1)
      .fromTo(chars, { yPercent: 130, opacity: 0 },
                     { yPercent: 0, opacity: 1, duration: .75, ease: 'expo.out', stagger: .016 }, .22)
      // viên kính hiện ra đang phồng rồi xẹp xuống như giọt nước
      .add(dropLens, .35)
  } else {
    press(false);
    tl = gsap.timeline({ onComplete: () => {
  sheet.classList.remove('is-open', 'edge-fx', 'edge-lite');
  gsap.set([panel, ...kids, ...chars], { clearProps: 'all' });
  panel.style.setProperty('--lit', '0');
  hideLens(); touching = false;
} });
    tl.to(kids, { opacity: 0, y: -8, duration: .18, stagger: { each: .02, from: 'end' } }, 0)
      .to(blob, { opacity: 0, duration: .15 }, 0)
      .to(panel, { rotationX: 0, rotationY: 0, duration: .2 }, 0)
      .fromTo(panel, { clipPath: full, transformOrigin: from.origin },
                     { clipPath: from.clip, y: -10, scaleX: .94, scaleY: 1, duration: .5, ease: 'power3.inOut' }, .05)
      .to(scrim, { opacity: 0, duration: .35 }, .1);
  }
}
burger.addEventListener('click', () => setMenu(!isOpen));
scrim.addEventListener('click', () => setMenu(false));
window.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && isOpen) { setMenu(false); burger.focus(); }
});
window.matchMedia('(min-width: 861px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

  /* ----- HÀM 5: bấm link nội bộ thì cuộn mượt (dùng Lenis nếu có), chừa chỗ cho viên thuốc ----- */
  function goTo(href) {
    let t = document.querySelector(href);
    if (!t && href === '#contact') t = document.getElementById('footer');   // chưa có section liên hệ thì xuống chân trang
    if (href === '#hero' && !t) {
      if (window.__lenis) window.__lenis.scrollTo(0, { duration: 1.2 }); else window.scrollTo({ top: 0, behavior: 'smooth' });
      return true;
    }
    if (!t) return false;
if (window.__lenis) window.__lenis.scrollTo(t, { offset: -72, duration: 1.2, force: true });
    else t.scrollIntoView({ behavior: 'smooth', block: 'start' });
    return true;
  }
  [...root.querySelectorAll('a[href^="#"]'), ...sheet.querySelectorAll('a[href^="#"]')].forEach((a) => {
    a.addEventListener('click', (e) => {
      if (sheet.contains(a)) setMenu(false);             // bấm link trong menu thì đóng menu trước
      if (goTo(a.getAttribute('href'))) e.preventDefault();
    });
  });
</script>