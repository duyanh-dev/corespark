<!-- ============ JS riêng của Nav ============ -->
<script>
import gsap from 'gsap';

  const root = document.querySelector('.nav');
  const bar = root.querySelector('.nav__bar');
  const burger = root.querySelector('.nav__burger');
  const sheet = document.querySelector('.nav__sheet');
  const linksWrap = root.querySelector('.nav__links');
  const lens = root.querySelector('.nav__lens');
  const items = Array.from(linksWrap.querySelectorAll('a'));
  const targets = items.map((a) => document.querySelector(a.getAttribute('href')));
  const panel = sheet.querySelector('.nav__panel');
  const scrim = sheet.querySelector('.nav__scrim');
  const sheetItems = Array.from(sheet.querySelectorAll('.nav__item'));

  /* ----- HÀM 0: KHÚC XẠ LIQUID GLASS -----
     Vẽ "bản đồ dịch chuyển" cho viên thuốc: mỗi điểm ảnh mã hoá hướng + độ lệch (R = ngang, G = dọc, 128 = đứng yên).
     Càng gần mép, hình nền càng bị kéo từ phía trong ra (độ lệch giảm dần theo đường cong, ở giữa = 0 nên chữ không méo). */
  const BEZEL = 16;       // độ dày vùng khúc xạ ở mép (px)
  const MAXD = 18;        // độ lệch tối đa ở sát mép (px)
  const filt = document.getElementById('nav-glass');
  const fimg = document.getElementById('nav-map');
  // Chỉ bật khi trình duyệt cho dùng url() trong backdrop-filter (Chromium). Safari/Firefox dùng kính mờ thường.
  const canRefract = !!filt && !!window.chrome && typeof CSS !== 'undefined' && CSS.supports('backdrop-filter', 'url(#nav-glass)');

  // Vẽ bản đồ dịch chuyển cho hình chữ nhật bo góc w×h (bán kính r, vùng khúc xạ dày bz), trả về data URL.
  // Dùng chung cho viên thuốc (r = h/2) và tấm kính của menu điện thoại.
  function drawMap(w, h, r, bz) {
    const c = document.createElement('canvas');
    c.width = w; c.height = h;
    const cx = c.getContext('2d');
    const img = cx.createImageData(w, h);
    const d = img.data;
    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        // điểm gần nhất trên "xương sống" (hình chữ nhật thu nhỏ r mỗi phía), rồi tính pháp tuyến ra ngoài
        const px = Math.min(Math.max(x + 0.5, r), w - r);
        const py = Math.min(Math.max(y + 0.5, r), h - r);
        const dx = x + 0.5 - px, dy = y + 0.5 - py;
        const dist = Math.hypot(dx, dy);
        const depth = r - dist;                       // khoảng cách từ mép vào trong
        let vx = 0, vy = 0;
        if (dist > 1e-4 && depth >= 0 && depth < bz) {
          const m = Math.pow(1 - depth / bz, 2.2);    // mạnh nhất ở mép, tắt mượt vào trong
          vx = -(dx / dist) * m; vy = -(dy / dist) * m; // lấy mẫu từ phía TRONG nên không bao giờ chạm ngoài khung
        }
        const i = (y * w + x) * 4;
        d[i] = 128 + 127 * vx; d[i + 1] = 128 + 127 * vy; d[i + 2] = 128; d[i + 3] = 255;
      }
    }
    cx.putImageData(img, 0, 0);
    return c.toDataURL('image/png');
  }

  function buildMap() {
    const w = Math.round(bar.offsetWidth), h = Math.round(bar.offsetHeight);
    if (!w || !h) return;
    const r = h / 2;
    // Cập nhật vùng lọc + ảnh + độ mạnh theo kích thước thật
    filt.setAttribute('width', w); filt.setAttribute('height', h);
    fimg.setAttribute('width', w); fimg.setAttribute('height', h);
    fimg.setAttribute('href', drawMap(w, h, r, Math.min(r, BEZEL)));
    filt.querySelector('feDisplacementMap').setAttribute('scale', String(MAXD * 2));
    root.classList.add('has-refract');
  }
  if (canRefract) {
    let pending = 0;
    // Vẽ lại bản đồ khi viên thuốc đổi kích thước (xoay màn hình, đổi cỡ cửa sổ), gộp theo khung hình
    new ResizeObserver(() => { cancelAnimationFrame(pending); pending = requestAnimationFrame(buildMap); }).observe(bar);
    buildMap();
  }

  /* ----- HÀM 0b: khúc xạ cho TẤM KÍNH của menu điện thoại -----
     Chỉ bật trên Chromium và máy đủ khoẻ (>= 6 nhân): bộ lọc chạy trên cả tấm kính nên tốn hơn viên thuốc.
     Máy yếu / trình duyệt khác tự dùng kính mờ thường, vẫn đủ viền sáng + thẻ nổi khối. */
  const pfilt = document.getElementById('nav-panel-glass');
  const pimg = document.getElementById('nav-panel-map');
  const PBEZEL = 22, PMAXD = 20;
  const canPanelRefract = canRefract && !!pfilt && !!pimg && (navigator.hardwareConcurrency || 4) >= 6;
  function buildPanelMap() {
    const w = Math.round(panel.offsetWidth), h = Math.round(panel.offsetHeight);
    if (!w || !h) return;                                                  // đang ẩn (màn rộng): bỏ qua
    const r = Math.min(parseFloat(getComputedStyle(panel).borderTopLeftRadius) || 32, h / 2, w / 2);
    pfilt.setAttribute('width', w); pfilt.setAttribute('height', h);
    pimg.setAttribute('width', w); pimg.setAttribute('height', h);
    pimg.setAttribute('href', drawMap(w, h, r, Math.min(r, PBEZEL)));
    pfilt.querySelector('feDisplacementMap').setAttribute('scale', String(PMAXD * 2));
    sheet.classList.add('has-refract');
  }
  if (canPanelRefract) {
    let pp = 0;
    new ResizeObserver(() => { cancelAnimationFrame(pp); pp = requestAnimationFrame(buildPanelMap); }).observe(panel);
  }

  /* ----- HÀM 1: viền sáng xoay theo con trỏ (ánh sáng "soi" từ phía con trỏ) ----- */
  if (window.matchMedia('(pointer: fine)').matches) {
    window.addEventListener('pointermove', (e) => {
      const r = bar.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width / 2);
      const dy = e.clientY - (r.top + r.height / 2);
      let a = (Math.atan2(dx, -dy) * 180) / Math.PI;   // 0deg = phía trên, quay theo chiều kim đồng hồ
      if (a < 0) a += 360;
      bar.style.setProperty('--ang', `${a.toFixed(1)}deg`);
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => bar.style.removeProperty('--ang'));
  }

  /* ----- HÀM 2: thấu kính trượt tới một mục (hoặc ẩn nếu không có) ----- */
  let active = null;
  function placeLens(el) {
    if (!el) { lens.classList.remove('is-on'); return; }
    lens.style.setProperty('--lx', `${el.offsetLeft}px`);
    lens.style.setProperty('--lw', `${el.offsetWidth}px`);
    lens.classList.add('is-on');
  }
  if (window.matchMedia('(pointer: fine)').matches) {
    items.forEach((a) => a.addEventListener('pointerenter', () => placeLens(a)));
    linksWrap.addEventListener('pointerleave', () => placeLens(active));   // rời menu thì thấu kính về mục đang xem
  }
  items.forEach((a) => a.addEventListener('focus', () => placeLens(a)));
  linksWrap.addEventListener('focusout', () => placeLens(active));

  /* Điểm có y này đang nằm trong section ".dark" không? (dùng cho cả viên thuốc lẫn tấm kính menu) */
  const isDarkAt = (py) => Array.from(document.querySelectorAll('.dark')).some((s) => {
    const r = s.getBoundingClientRect();
    return r.top <= py && r.bottom >= py;
  });
  /* Tấm kính menu đổi tông theo phần trang nằm ngay sau nó (trang bị khoá cuộn lúc mở nên đo một lần là đủ) */
  function syncSheetTone() {
    const br = bar.getBoundingClientRect();
    sheet.classList.toggle('nav__sheet--dark', isDarkAt(br.bottom + 12 + panel.offsetHeight / 2));
  }

  /* ----- HÀM 3: mỗi khung hình cuộn: đổi tông, đổ bóng, mục đang xem ----- */
  let ticking = false;
  function update() {
    ticking = false;
    const y = window.scrollY;
    const vh = window.innerHeight;

    // 3a. Đã cuộn thì bóng đậm hơn
    root.classList.toggle('is-scrolled', y > 24);

    // 3b. Tông sáng/tối: lấy điểm giữa viên thuốc, nằm trong section ".dark" thì bật tông tối
    const br = bar.getBoundingClientRect();
    const py = br.top + br.height / 2;
    root.classList.toggle('nav--dark', isDarkAt(py));

    // 3c. Scrollspy: mục nào đang chạm vạch 40% chiều cao màn hình thì là mục hiện tại
    let next = null;
    targets.forEach((t, i) => {
      if (!t) return;
      const r = t.getBoundingClientRect();
      if (r.top <= vh * 0.4 && r.bottom > vh * 0.4) next = items[i];
    });
    if (next !== active) {
      active = next;
      items.forEach((a) => (a === active ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      const cur = active && active.getAttribute('href');                       // đồng bộ sang thẻ trong menu điện thoại
      sheetItems.forEach((a) => (a.getAttribute('href') === cur ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      if (!linksWrap.matches(':hover')) placeLens(active);
    }
  }
  window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  window.addEventListener('resize', () => { update(); placeLens(active); });
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => placeLens(active));  // đo lại khi font tải xong
  update();

/* ----- HÀM 4: menu điện thoại (GSAP) + VIÊN KÍNH LỎNG kiểu iOS 26 ----- */
const list = panel.querySelector('.nav__list');
const rowsEl = panel.querySelector('.nav__rows');
const blob = panel.querySelector('.nav__blob');
const mag = panel.querySelector('.nav__mag');
const grab = panel.querySelector('.nav__grab');
const lfilt = document.getElementById('nav-lens');
const limg = document.getElementById('nav-lens-map');
const dR = document.getElementById('nav-lens-r');
const dG = document.getElementById('nav-lens-g');
const dB = document.getElementById('nav-lens-b');
const liteFilt = document.getElementById('nav-lens-lite');
const liteImg = document.getElementById('nav-lens-map-lite');
const XLINK = 'http://www.w3.org/1999/xlink';
const setHref = (el, url) => { el.setAttribute('href', url); el.setAttributeNS(XLINK, 'xlink:href', url); };
let lastS = 0;
const kids = [...sheet.querySelectorAll('.nav__item, .nav__cta2')];
const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const mobileMQ = window.matchMedia('(max-width: 860px)');
const FORCE_EDGE = false;   // thử đổi thành true trên iPhone để xem Safari có vẽ được khúc xạ mép không
const edgeFx = (canRefract || FORCE_EDGE) && !!lfilt && !!limg;
let isOpen = false, tl = null, touching = false;

// Tách tiêu đề thành từng chữ cái để trồi lên lần lượt
const chars = [];
sheet.querySelectorAll('.nav__txt b').forEach((b) => {
  const t = b.textContent;
  b.closest('.nav__item').setAttribute('aria-label', t);
  b.textContent = '';
  [...t].forEach((c) => {
    const s = document.createElement('span');
    s.className = 'ch'; s.setAttribute('aria-hidden', 'true'); s.textContent = c;
    b.appendChild(s); chars.push(s);
  });
});

// Bản sao các mục nằm trong viên kính (để phóng đại). Tạo SAU khi tách chữ, bỏ href/aria cho khỏi trùng.
const magRows = sheetItems.map((r) => {
  const c = r.cloneNode(true);
  c.removeAttribute('href'); c.removeAttribute('aria-label'); c.removeAttribute('style');
  mag.appendChild(c);
  return c;
});

const mag2 = panel.querySelector('.nav__mag2');
const magRows2 = sheetItems.map((r) => {
  const c = r.cloneNode(true);
  c.removeAttribute('href'); c.removeAttribute('aria-label'); c.removeAttribute('style');
  mag2.appendChild(c);
  return c;
});

// Mục đang xem (aria-current) đổi ở HÀM 3 thì bản sao đổi theo
const syncCur = () => sheetItems.forEach((r, i) => {
  const on = r.getAttribute('aria-current') === 'true';
  [magRows[i], magRows2[i]].forEach((c) => on ? c.setAttribute('aria-current', 'true') : c.removeAttribute('aria-current'));
});
const mo = new MutationObserver(syncCur);
sheetItems.forEach((r) => mo.observe(r, { attributes: true, attributeFilter: ['aria-current'] }));
syncCur();

// Tìm mục dưới ngón tay bằng toạ độ, không phụ thuộc hit-test nên mask hay viên kính không làm sai
const rowAt = (e) => sheetItems.find((r) => {
  const b = r.getBoundingClientRect();
  return e.clientX >= b.left && e.clientX <= b.right && e.clientY >= b.top && e.clientY <= b.bottom;
}) || null;

// Đi tới một mục: đóng menu rồi cuộn (cùng đường với khi bấm link)
function activate(row) {
  const href = row.getAttribute('href');
