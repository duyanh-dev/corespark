---
/* =========================================================
   FOOTER.ASTRO - coreSpark · Liquid Glass (phẳng, không gradient)
   Cần cài:  npm i gsap

   Ý tưởng:
   - Nền sáng phẳng + vài quả cầu màu đặc trôi chậm phía sau (để kính có thứ để khúc xạ)
   - Chữ "coreSpark" khổng lồ, hiện lên theo nhịp khi cuộn tới (GSAP + ScrollTrigger)
   - MÁY TÍNH (có chuột): thấu kính lỏng đi theo con trỏ, kéo giãn theo tốc độ như giọt chất lỏng,
     bẻ cong chữ phía sau (SVG displacement + backdrop-filter, Chromium)
   - ĐIỆN THOẠI (cảm ứng): KHÔNG có thấu kính, không phản ứng khi nhấn giữ / vuốt.
     Thay bằng: chữ nghiêng đàn hồi theo tốc độ cuộn, và chạm nhanh (tap) để gợn sóng
   - Các khối CTA / liên kết / thanh dưới đều là kính
   SỬA Ở ĐÂY: email, link mạng xã hội, câu mời gọi
   ========================================================= */
const year = new Date().getFullYear();
const email = 'buiduyanh.17042001@gmail.com';
const site = 'https://duyanh-dev.github.io/';

// Để h rỗng '' thì mục đó tự ẩn
const socials = [
  { t: 'GitHub',   h: 'https://github.com/duyanh-dev' },
  { t: 'Facebook', h: 'https://www.facebook.com/duy.anh.207927' },
  { t: 'Zalo',     h: 'https://zalo.me/0842695949' },
];

const explore = [
  { t: 'Quy trình', h: '#process' },
  { t: 'Studio',    h: '#studio' },
  // { t: 'Dự án', h: '#showcase' }, { t: 'Liên hệ', h: '#contact' },
];
const connect = [
  { t: 'Email', h: `mailto:${email}`, ext: false },
  ...socials.filter((s) => s.h).map((s) => ({ t: s.t, h: s.h, ext: true })),
];
const word = 'coreSpark'.split('');
// Tách mỗi chữ thành một span làm mất kerning gốc của font, nên chỉnh tay ở đây (đơn vị em).
//          c     o     r     e     S      p      a     r     k
const kern = [0,    0,    0,    0,    0.012, 0.03,  0,    0,    0];
---

<footer class="foot" id="footer">
  <!-- Bộ lọc khúc xạ cho thấu kính (bản đồ dịch chuyển được tạo bằng JS, chỉ trên máy có chuột) -->
  <svg class="foot__defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="foot-lens" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
      <feImage id="foot-lens-map" x="0" y="0" width="168" height="168" preserveAspectRatio="none" result="map" />
      <feDisplacementMap in="SourceGraphic" in2="map" scale="70" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>

  <!-- Những quả cầu màu đặc: chỉ để kính khúc xạ, không gradient -->
  <div class="foot__orbs" aria-hidden="true">
    <i class="orb orb--blue"></i>
    <i class="orb orb--violet"></i>
    <i class="orb orb--pink"></i>
    <i class="orb orb--amber"></i>
  </div>

  <div class="foot__top">
    <div class="foot__cta glass">
      <h2 class="foot__ask">Cần một Landing Page bứt phá?<br />Hay Portfolio đậm chất riêng?</h2>
      <a class="foot__mail" href={`mailto:${email}`}>
        <span>{email}</span><i aria-hidden="true">↗</i>
      </a>
    </div>

    <nav class="foot__cols glass" aria-label="Chân trang">
      <div class="foot__col">
        <h3>Khám phá</h3>
        <ul>
          {explore.map((l) => <li><a class="foot__link" href={l.h}>{l.t}</a></li>)}
        </ul>
      </div>
      <div class="foot__col">
        <h3>Kết nối</h3>
        <ul>
          {connect.map((l) => (
            <li>
              <a class="foot__link" href={l.h} target={l.ext ? '_blank' : undefined} rel={l.ext ? 'noopener' : undefined}>
                {l.t}{l.ext && <i aria-hidden="true">↗</i>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>

  <!-- Chữ khổng lồ: mỗi chữ cái là một span để GSAP điều khiển riêng -->
  <div class="mark" role="img" aria-label="coreSpark">
    {word.map((ch, i) => <span class="mark__l" style={`--k:${kern[i] ?? 0}`} aria-hidden="true">{ch}</span>)}
  </div>

  <!-- Thấu kính lỏng (chỉ máy có chuột) + gợn sóng khi bấm -->
  <div class="lens" aria-hidden="true"></div>
  <div class="ripple" aria-hidden="true"></div>

  <!-- Thanh dưới: kính nổi kiểu Dock -->
  <div class="dock glass">
    <p class="dock__copy">© {year} coreSpark. Mọi quyền được bảo lưu.</p>

    <p class="dock__clock">
      <span>Sài Gòn</span>
      <time class="dock__time">--:--:--</time>
    </p>

    <p class="dock__credit">
      Thiết kế &amp; lập trình bởi
      <a class="credit" href={site} target="_blank" rel="noopener">duyanh.dev<i aria-hidden="true">↗</i></a>
    </p>

    <button class="dock__up" type="button" aria-label="Về đầu trang"><span aria-hidden="true">↑</span></button>
  </div>
</footer>

<style>
  .foot {
    position: relative; overflow: clip; isolation: isolate;
    background: #f5f5f7; color: #1d1d1f;
    padding-top: clamp(3.5rem, 8vw, 6.5rem);
    -webkit-tap-highlight-color: transparent;
  }
  .foot, .foot *, .foot *::before, .foot *::after { box-sizing: border-box; }
  .foot__defs { position: absolute; width: 0; height: 0; pointer-events: none; }

  /* ---------- Bong bóng kính màu, chìm phía sau chữ khổng lồ ---------- */
  .foot__orbs { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .orb {
    position: absolute; display: block; border-radius: 50%; will-change: transform;
    background: rgba(var(--c), .32);
    -webkit-backdrop-filter: blur(1.5px) saturate(1.9);
            backdrop-filter: blur(1.5px) saturate(1.9);
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, .78),
      inset 0 14px 26px -6px rgba(255, 255, 255, .6),
      inset 0 -16px 30px -8px rgba(var(--c), .6),
      0 30px 60px -24px rgba(var(--c), .55);
  }
  .orb::before, .orb::after { content: ''; position: absolute; border-radius: 50%; background: #fff; transform: rotate(-32deg); }
  .orb::before { left: 15%; top: 9%; width: 34%; height: 17%; opacity: .9; filter: blur(1.5px); }
  .orb::after  { right: 14%; bottom: 11%; width: 16%; height: 8%; opacity: .55; filter: blur(1px); }
  .orb--blue   { --c: 10, 132, 255; width: 25vw; height: 25vw; left: -5vw; bottom: 6rem; }
  .orb--violet { --c: 191, 90, 242; width: 17vw; height: 17vw; left: 30vw; bottom: 3rem; }
  .orb--pink   { --c: 255, 55, 95;  width: 21vw; height: 21vw; right: 5vw; bottom: 9rem; }
  .orb--amber  { --c: 255, 159, 10; width: 13vw; height: 13vw; left: 60vw; bottom: 4rem; }

  /* ---------- Chất liệu kính ---------- */
  .glass {
    background: rgba(255, 255, 255, .46);
    -webkit-backdrop-filter: blur(26px) saturate(185%);
            backdrop-filter: blur(26px) saturate(185%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, .6),
      inset 0 1.5px 0 rgba(255, 255, 255, .95),
      inset 0 -1px 0 rgba(0, 0, 0, .05),
      0 18px 40px -12px rgba(0, 0, 0, .14),
      0 1px 3px rgba(0, 0, 0, .06);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass { background: rgba(255, 255, 255, .88); }
  }

  /* ---------- Phần trên ---------- */
  .foot__top {
    position: relative; z-index: 2;
    display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: clamp(1rem, 2vw, 1.6rem); align-items: stretch;
    padding: 0 max(var(--gutter, 1.5rem), 1rem);
  }
  .foot__cta, .foot__cols { min-width: 0; }
  .foot__cta {
    display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; gap: 2rem;
    padding: clamp(1.6rem, 3.6vw, 3rem); border-radius: clamp(1.6rem, 3vw, 2.4rem);
  }
  .foot__ask { margin: 0; font-size: clamp(1.9rem, 4.4vw, 3.7rem); line-height: 1.05; letter-spacing: -.035em; font-weight: 700; }

  /* Nút email: x/y do GSAP gán để nút "hút" theo chuột (chỉ máy có chuột) */
  .foot__mail {
    display: inline-flex; align-items: center; gap: .7rem;
    max-width: 100%; padding: .95rem 1.6rem; border-radius: 999px;
    background: rgba(10, 132, 255, .92); color: #fff; font-weight: 600; font-size: 1.05rem; text-decoration: none;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .5),
      inset 0 0 0 1px rgba(255, 255, 255, .22),
      0 12px 26px -6px rgba(10, 132, 255, .45);
    transition: scale .3s cubic-bezier(.2, .9, .3, 1.3), background .25s;
    will-change: transform;
  }
  .foot__mail span { min-width: 0; overflow-wrap: anywhere; }
  .foot__mail i { flex: none; font-style: normal; display: inline-block; transition: transform .3s cubic-bezier(.2, .9, .3, 1.4); }
  .foot__mail:active { scale: .95; }
  .foot__mail:focus-visible { outline: 2px solid #fff; outline-offset: 3px; box-shadow: 0 0 0 5px #0a84ff; }

  .foot__cols {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem;
    padding: clamp(1.4rem, 3vw, 2.2rem); border-radius: clamp(1.6rem, 3vw, 2.4rem);
  }
  .foot__col h3 { margin: 0 0 .7rem; font-size: .85rem; font-weight: 600; color: #6e6e73; }
  .foot__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .2rem; }
  .foot__link {
    display: inline-flex; align-items: center; gap: .4rem;
    margin-left: -.9rem; padding: .45rem .9rem; border-radius: 999px;
    font-size: 1.1rem; font-weight: 500; color: #1d1d1f; text-decoration: none;
    transition: background .25s, box-shadow .25s, transform .35s cubic-bezier(.2, .9, .3, 1.3);
  }
  .foot__link i { font-style: normal; font-size: .8em; color: #86868b; transition: transform .3s cubic-bezier(.2, .9, .3, 1.4), color .25s; }
  .foot__link:active { transform: scale(.96); background: rgba(255, 255, 255, .78); }
  .foot__link:focus-visible { outline: 2px solid #0a84ff; outline-offset: 2px; }

  /* Hover chỉ áp cho máy có chuột: tránh lỗi "hover dính" trên điện thoại */
  @media (hover: hover) and (pointer: fine) {
    .foot__mail:hover { scale: 1.04; background: #0a84ff; }
    .foot__mail:hover i { transform: translate(3px, -3px) rotate(8deg); }
    .foot__link:hover, .foot__link:focus-visible {
      background: rgba(255, 255, 255, .78); transform: translateX(4px);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .95), 0 6px 16px -6px rgba(0, 0, 0, .18);
    }
    .foot__link:hover i { color: #0a84ff; transform: translate(2px, -2px); }
    .credit:hover, .credit:focus-visible { color: #0071e3; text-decoration-color: currentColor; }
    .credit:hover i, .credit:focus-visible i { opacity: 1; transform: none; }
    .dock__up:hover { transform: translateY(-3px); background: #0a84ff; }
  }

  /* ---------- Chữ khổng lồ ---------- */
  .mark {
    position: relative; z-index: 2;
    display: flex; justify-content: center;
    margin-top: clamp(1rem, 3vw, 2.5rem); padding: clamp(2.2rem, 6vw, 4.5rem) 0 clamp(1.6rem, 4vw, 3rem);
    font-size: clamp(3.4rem, 18.4vw, 19rem); font-weight: 800; letter-spacing: -.065em; line-height: .85;
    white-space: nowrap; overflow-x: clip; touch-action: pan-y;
    /* Chặn hẳn việc nhấn giữ bôi đen chữ / hiện kính lúp & menu của iOS, Android */
    user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
  }
  .mark__l {
    display: inline-block; color: #1d1d1f; transform-origin: 50% 85%; will-change: transform;
    margin-left: calc(var(--k, 0) * 1em);
    padding-bottom: .18em; margin-bottom: -.18em;   /* chừa chỗ cho đuôi chữ p */
    font-kerning: normal;
  }

  /* ---------- Thấu kính lỏng (JS bật, chỉ máy có chuột; mặc định ẩn hẳn) ---------- */
  .lens {
    position: absolute; left: 0; top: 0; z-index: 4;
    width: 168px; height: 168px; margin: -84px 0 0 -84px; border-radius: 50%;
    pointer-events: none; opacity: 0; visibility: hidden; transform: scale(0);
    user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
    -webkit-backdrop-filter: blur(1.5px) saturate(1.5);
            backdrop-filter: blur(1.5px) saturate(1.5);
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, .75),
      inset 0 3px 8px rgba(255, 255, 255, .85),
      inset 0 -4px 10px rgba(0, 0, 0, .07),
      0 16px 36px -8px rgba(0, 0, 0, .22);
    will-change: transform, opacity;
  }

  /* ---------- Gợn sóng khi bấm ---------- */
  .ripple {
    position: absolute; left: 0; top: 0; z-index: 3;
    width: 120px; height: 120px; margin: -60px 0 0 -60px; border-radius: 50%;
    pointer-events: none; opacity: 0;
    background: rgba(255, 255, 255, .14);
    -webkit-backdrop-filter: blur(3px) saturate(1.6);
            backdrop-filter: blur(3px) saturate(1.6);
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, .9), 0 0 0 1px rgba(0, 0, 0, .03);
    will-change: transform, opacity;
  }

  /* ---------- Thanh Dock dưới cùng ---------- */
  .dock {
    position: relative; z-index: 5;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .6rem 1.6rem;
    margin: 0 max(var(--gutter, 1.5rem), 1rem) calc(1.5rem + env(safe-area-inset-bottom, 0px)); padding: .65rem .65rem .65rem 1.6rem;
    border-radius: 999px; font-size: .88rem; color: #6e6e73;
  }
  .dock p { margin: 0; }
  .dock__clock { display: inline-flex; gap: .5rem; align-items: baseline; }
  .dock__time { font-variant-numeric: tabular-nums; color: #1d1d1f; font-weight: 600; }

  .dock__credit { display: inline-flex; align-items: baseline; gap: .35rem; flex-wrap: wrap; }
  .credit {
    display: inline-flex; align-items: baseline; gap: .2rem;
    color: #1d1d1f; font-weight: 500; text-decoration: underline; text-decoration-color: transparent;
    text-underline-offset: .22em; text-decoration-thickness: 1px;
    transition: color .25s, text-decoration-color .25s;
  }
  .credit i {
    font-style: normal; font-size: .85em; color: #0071e3;
    opacity: 0; transform: translate(-3px, 3px);
    transition: opacity .25s, transform .3s cubic-bezier(.2, .9, .3, 1);
  }
  .credit:focus-visible { outline: 2px solid #0071e3; outline-offset: 3px; border-radius: 4px; color: #0071e3; text-decoration-color: currentColor; }
  .credit:focus-visible i { opacity: 1; transform: none; }

  .dock__up {
    width: 2.7rem; height: 2.7rem; border: 0; border-radius: 50%; padding: 0; cursor: pointer;
    background: rgba(29, 29, 31, .92); color: #fff; font-size: 1.15rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .25), 0 6px 14px -4px rgba(0, 0, 0, .35);
    transition: transform .3s cubic-bezier(.2, .9, .3, 1.4), background .25s;
  }
  .dock__up:active { transform: scale(.9); }
  .dock__up:focus-visible { outline: 2px solid #0a84ff; outline-offset: 3px; }

  /* ---------- Điện thoại và tablet: nhẹ GPU hơn ---------- */
  @media (max-width: 800px) {
    .foot__top { grid-template-columns: minmax(0, 1fr); }
    .foot__cta { gap: 1.4rem; }
    .foot__mail { padding: .8rem 1.2rem; font-size: .95rem; }
    .foot__cols { gap: 1rem; }
    .foot__link { font-size: 1rem; }
    .mark { font-size: 14vw; letter-spacing: -.07em; padding-inline: 1rem; }
    .dock { border-radius: 1.6rem; padding: 1rem 1.2rem; }
    .dock__up { margin-left: auto; }
    .orb--blue { width: 30vw; height: 30vw; bottom: 5rem; }
    .orb--violet { width: 22vw; height: 22vw; bottom: 3.5rem; }
    .orb--pink { width: 26vw; height: 26vw; bottom: 6.5rem; }
    .orb--amber { width: 17vw; height: 17vw; bottom: 4rem; }

    /* Bỏ blur nền ở bóng và gợn sóng (vùng rộng, tốn GPU), giảm blur của các khối kính */
    .orb { -webkit-backdrop-filter: none; backdrop-filter: none; }
    .ripple { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(255, 255, 255, .28); }
    .glass { -webkit-backdrop-filter: blur(16px) saturate(170%); backdrop-filter: blur(16px) saturate(170%); }
  }

  @media (max-width: 480px) {
    .mark { font-size: 12.6vw; }
    .foot__ask { font-size: 1.75rem; }
    .foot__cta, .foot__cols { padding: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lens, .ripple { display: none; }
    .foot__mail, .foot__link, .foot__link i, .credit, .credit i, .dock__up { transition: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const foot = document.querySelector<HTMLElement>('.foot')!;
  const mark = foot.querySelector<HTMLElement>('.mark')!;
  const letters = Array.from(mark.querySelectorAll<HTMLElement>('.mark__l'));
  const lens = foot.querySelector<HTMLElement>('.lens')!;
  const ripple = foot.querySelector<HTMLElement>('.ripple')!;
  const mail = foot.querySelector<HTMLElement>('.foot__mail')!;
  const upBtn = foot.querySelector<HTMLElement>('.dock__up')!;
  const timeEl = foot.querySelector<HTMLElement>('.dock__time')!;
  const orbs = Array.from(foot.querySelectorAll<HTMLElement>('.orb'));

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  /* CHỈ máy có chuột thật mới có thấu kính, lực hút, quả cầu trôi. Điện thoại / máy tính bảng cảm ứng thì không */
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const LS = 168; // kích thước thấu kính (px), khớp với CSS

  /* ---------- Đồng hồ Sài Gòn: chỉ chạy khi footer đang nhìn thấy và tab đang mở ---------- */
  const fmt = new Intl.DateTimeFormat('vi-VN', {
    timeZone: 'Asia/Ho_Chi_Minh', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
  });
  let inView = false;
  const tickClock = () => { if (inView && !document.hidden) timeEl.textContent = fmt.format(new Date()); };
  new IntersectionObserver(([e]) => { inView = e.isIntersecting; tickClock(); }, { rootMargin: '100px' }).observe(foot);
  setInterval(tickClock, 1000);

  /* ---------- Về đầu trang (dùng Lenis nếu có) ---------- */
  upBtn.addEventListener('click', () => {
    const w = window as any;
    if (w.__lenis) w.__lenis.scrollTo(0, { duration: 1.4 });
    else window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  /* Chặn menu ngữ cảnh khi nhấn giữ trên chữ khổng lồ (Android) */
  mark.addEventListener('contextmenu', (e) => e.preventDefault());

  if (!reduce) {
    /* ---------- Vị trí gốc của từng chữ (đo lại gọn trong 1 khung hình) ---------- */
    let base: { cx: number; cy: number }[] = [];
    const measure = () => {
      base = letters.map((l) => ({ cx: l.offsetLeft + l.offsetWidth / 2, cy: l.offsetTop + l.offsetHeight / 2 }));
    };
    let measureRaf = 0;
    const measureSoon = () => { if (!measureRaf) measureRaf = requestAnimationFrame(() => { measureRaf = 0; measure(); }); };
    measure();
    new ResizeObserver(measureSoon).observe(foot);
    document.fonts?.ready.then(measure);

    /* ---------- Chữ hiện lên một lần khi cuộn tới ---------- */
    gsap.from(letters, {
      yPercent: 70, opacity: 0, rotate: () => gsap.utils.random(-9, 9),
      duration: 1.25, ease: 'expo.out', stagger: 0.07,
      scrollTrigger: { trigger: mark, start: 'top 88%', once: true },
    });

    /* ---------- Cuộn: chữ nghiêng đàn hồi theo tốc độ cuộn (chạy được cả trên điện thoại) ---------- */
    const skewQ = gsap.quickTo(mark, 'skewX', { duration: 0.7, ease: 'power3' });
    let skewT = 0;
    ScrollTrigger.create({
      trigger: foot, start: 'top bottom', end: 'bottom top',
      onUpdate: (self) => {
        skewQ(gsap.utils.clamp(-5, 5, self.getVelocity() / -350));
        clearTimeout(skewT);
        skewT = window.setTimeout(() => skewQ(0), 90);   // ngừng cuộn thì bật về thẳng
      },
    });

    /* ---------- Gợn sóng kính + chữ nảy theo sóng ---------- */
    const wave = (x: number, y: number, clientX: number, clientY: number) => {
      gsap.killTweensOf(ripple);
      gsap.fromTo(ripple, { x, y, scale: 0.2, opacity: 1 }, { scale: 5, opacity: 0, duration: 1.2, ease: 'expo.out' });
      const mr = mark.getBoundingClientRect();
      letters.forEach((el, i) => {
        const b = base[i]; if (!b) return;
        const d = Math.hypot(mr.left + b.cx - clientX, mr.top + b.cy - clientY);
        const f = Math.max(0, 1 - d / (mr.width * 0.7));
        if (f <= 0) return;
        gsap.fromTo(el, { yPercent: -22 * f }, {
          yPercent: 0, duration: 1.3, ease: 'elastic.out(1, 0.45)', delay: d / 2200, overwrite: 'auto',
        });
      });
    };
    const fire = (clientX: number, clientY: number) => {
      const fr = foot.getBoundingClientRect();
      wave(clientX - fr.left, clientY - fr.top, clientX, clientY);
    };

    /* Chuột: bấm là gợn sóng. Cảm ứng: chỉ khi CHẠM NHANH (dưới 260ms, gần như không xê dịch).
       Nhấn giữ, vuốt cuộn (trình duyệt gửi pointercancel) đều bị bỏ qua. */
    let down: { x: number; y: number; t: number } | null = null;
    foot.addEventListener('pointerdown', (e) => {
      if ((e.target as Element).closest('a, button')) return;
      if (e.pointerType === 'touch') { down = { x: e.clientX, y: e.clientY, t: performance.now() }; return; }
      fire(e.clientX, e.clientY);
    });
    foot.addEventListener('pointerup', (e) => {
      if (e.pointerType !== 'touch' || !down) return;
      const quick = performance.now() - down.t < 260 && Math.hypot(e.clientX - down.x, e.clientY - down.y) < 10;
      down = null;
      if (quick) fire(e.clientX, e.clientY);
    });
    foot.addEventListener('pointercancel', () => { down = null; });

    upBtn.addEventListener('click', () => {
      const fr = foot.getBoundingClientRect(), br = upBtn.getBoundingClientRect();
      wave(br.left - fr.left + br.width / 2, br.top - fr.top + br.height / 2, br.left + br.width / 2, br.top + br.height / 2);
    });

    /* =====================================================
       CHỈ MÁY CÓ CHUỘT: quả cầu trôi, thấu kính lỏng, chữ nhấc lên, nút email từ tính
       ===================================================== */
    if (canHover) {
      /* ---------- Quả cầu trôi chậm, dừng khi footer ra khỏi màn hình ---------- */
      const drift = gsap.timeline({ paused: true });
      orbs.forEach((o, i) => {
        drift.to(o, {
          x: () => gsap.utils.random(-60, 60), y: () => gsap.utils.random(-40, 40), force3D: true,
          duration: gsap.utils.random(7, 11), ease: 'sine.inOut', yoyo: true, repeat: -1,
        }, i * 0.4);
      });
      ScrollTrigger.create({
        trigger: foot, start: 'top bottom', end: 'bottom top',
        onToggle: (s) => (s.isActive ? drift.play() : drift.pause()),
      });

      /* ---------- Bản đồ khúc xạ cho thấu kính (Chromium) ---------- */
      const canRefract = !!(navigator as any).userAgentData?.brands?.some((b: any) => /Chromium/i.test(b.brand));
      if (canRefract) {
        const c = document.createElement('canvas');
        c.width = c.height = LS;
        const g = c.getContext('2d')!;
        const img = g.createImageData(LS, LS);
        const R = LS / 2;
        for (let y = 0; y < LS; y++) {
          for (let x = 0; x < LS; x++) {
            const dx = x + 0.5 - R, dy = y + 0.5 - R;
            const d = Math.hypot(dx, dy), r = d / R;
            let cr = 128, cg = 128;
            if (r < 1 && d > 0) {
              const s = Math.min(1, Math.max(0, (r - 0.55) / 0.45));
              const sm = s * s * (3 - 2 * s);
              const m = 0.35 * r + 0.65 * sm * sm;
              cr = 128 - (dx / d) * m * 127;
              cg = 128 - (dy / d) * m * 127;
            }
            const i = (y * LS + x) * 4;
            img.data[i] = cr; img.data[i + 1] = cg; img.data[i + 2] = 128; img.data[i + 3] = 255;
          }
        }
        g.putImageData(img, 0, 0);
        document.getElementById('foot-lens-map')?.setAttribute('href', c.toDataURL());
        lens.style.backdropFilter = 'url(#foot-lens) blur(0.6px) saturate(1.6) brightness(1.05)';
      }

      /* ---------- Thấu kính lỏng: bám theo con trỏ bằng lò xo, kéo giãn theo tốc độ ----------
         Không xoay thấu kính (xoay sẽ làm lệch bản đồ khúc xạ), chỉ giãn theo trục X / Y */
      const S = { k: 0 };                         // mức hiện của kính: 0 ẩn, 1 hiện đủ
      let tx = 0, ty = 0, cx = 0, cy = 0, lensWant = false, ticking = false;

      const renderLens = (_t: number, dtMs: number) => {
        const dt = Math.min(dtMs, 50) / 1000;
        const f = 1 - Math.exp(-dt * 14);         // lò xo không phụ thuộc tốc độ khung hình
        const ddx = tx - cx, ddy = ty - cy;
        cx += ddx * f; cy += ddy * f;
        const ax = Math.min(0.16, Math.abs(ddx) / 600), ay = Math.min(0.16, Math.abs(ddy) / 600);
        const sx = 1 + ax - ay * 0.4, sy = 1 + ay - ax * 0.4;
        const k = S.k;
        lens.style.opacity = String(Math.min(1, k * 1.6));
        lens.style.transform = `translate3d(${cx}px,${cy}px,0) scale(${k * sx},${k * sy})`;
        if (!lensWant && k < 0.01) {              // đã ẩn xong: tắt hẳn vòng lặp, không tốn CPU/GPU
          lens.style.visibility = 'hidden';
          gsap.ticker.remove(renderLens);
          ticking = false;
        }
      };
      const showLens = (on: boolean) => {
        if (on === lensWant) return;
        lensWant = on;
        if (on && !ticking) {
          lens.style.visibility = 'visible';
          ticking = true;
          gsap.ticker.add(renderLens);
        }
        gsap.to(S, { k: on ? 1 : 0, duration: on ? 0.6 : 0.3, ease: on ? 'back.out(1.7)' : 'power2.in', overwrite: true });
      };

      /* ---------- Chữ nhấc lên nhẹ khi con trỏ lại gần ---------- */
      const qy = letters.map((l) => gsap.quickTo(l, 'y', { duration: 0.5, ease: 'power3' }));
      const qx = letters.map((l) => gsap.quickTo(l, 'x', { duration: 0.5, ease: 'power3' }));
      const qr = letters.map((l) => gsap.quickTo(l, 'rotation', { duration: 0.6, ease: 'power3' }));
      const qs = letters.map((l) => gsap.quickTo(l, 'scale', { duration: 0.5, ease: 'power3' }));

      const lift = (px: number | null, py: number, mr: DOMRect) => {
        const R = Math.max(120, mr.height * 1.1);
        letters.forEach((_, i) => {
          let tX = 0, tY = 0, tR = 0, tS = 1;
          const b = base[i];
          if (px !== null && b) {
            const dx = mr.left + b.cx - px, dy = mr.top + b.cy - py;
            const d = Math.hypot(dx, dy) || 1;
            if (d < R) {
              let f = 1 - d / R; f *= f;
              tX = (dx / d) * f * R * 0.16;
              tY = -f * mr.height * 0.16;
              tR = (dx / R) * f * 10;
              tS = 1 + f * 0.1;
            }
          }
          qx[i](tX); qy[i](tY); qr[i](tR); qs[i](tS);
        });
      };

      /* ---------- Nút email "từ tính" ---------- */
      const mx = gsap.quickTo(mail, 'x', { duration: 0.5, ease: 'power3' });
      const my = gsap.quickTo(mail, 'y', { duration: 0.5, ease: 'power3' });

      /* ---------- Gom mọi xử lý con trỏ vào đúng 1 lần mỗi khung hình ---------- */
      let px = 0, py = 0, onLink = false, raf = 0;
      const frame = () => {
        raf = 0;
        const fr = foot.getBoundingClientRect();
        const mr = mark.getBoundingClientRect();

        const inMark = !onLink && py > mr.top - 30 && py < mr.bottom + 30;
        if (inMark) {
          tx = px - fr.left; ty = py - fr.top;
          if (!lensWant) { cx = tx; cy = ty; }    // lần đầu hiện: đặt ngay tại con trỏ, không bay từ chỗ cũ
          showLens(true);
        } else showLens(false);

        onLink ? lift(null, 0, mr) : lift(px, py, mr);

        const r = mail.getBoundingClientRect();
        const dx = px - (r.left + r.width / 2), dy = py - (r.top + r.height / 2);
        if (Math.hypot(dx, dy) < 140) { mx(dx * 0.25); my(dy * 0.35); } else { mx(0); my(0); }
      };
      foot.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
        px = e.clientX; py = e.clientY;
        onLink = !!(e.target as Element).closest('a, button');
        if (!raf) raf = requestAnimationFrame(frame);
      });
      foot.addEventListener('pointerleave', () => {
        if (raf) { cancelAnimationFrame(raf); raf = 0; }
        showLens(false); lift(null, 0, mark.getBoundingClientRect()); mx(0); my(0);
      });
    }
  }
</script>