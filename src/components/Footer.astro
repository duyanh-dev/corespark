---
/* =========================================================
   FOOTER.ASTRO - Chân trang coreSpark (nền sáng, phẳng, không gradient)
   - Chữ "coreSpark" khổng lồ: từng chữ cái là một lò xo, né và nhảy theo con trỏ
   - Bấm bất kỳ đâu: bắn tia lửa (canvas), chữ giật nảy; cứ 10 lần là pháo hoa
   - Nút email "từ tính" hút theo chuột, đồng hồ Sài Gòn chạy thật
   - duyanh.dev: dòng ghi công nhỏ, tinh tế ở thanh dưới (kiểu Apple), không còn tia lửa
   SỬA Ở ĐÂY: email, link mạng xã hội, câu mời gọi
   ========================================================= */
const year = new Date().getFullYear();
const email = 'hello@duyanh.dev';        // đổi thành email thật
const site = 'https://duyanh.dev';

// Điền link thật vào đây; để rỗng '' thì mục đó tự ẩn
const socials = [
  { t: 'GitHub',   h: '' },              // vd: 'https://github.com/ten-ban'
  { t: 'Facebook', h: '' },
  { t: 'Zalo',     h: '' },
];

const explore = [
  { t: 'Quy trình', h: '#process' },
  { t: 'Studio',    h: '#studio' },
  // Khi có thêm section thì mở dòng dưới:
  // { t: 'Dự án', h: '#showcase' }, { t: 'Liên hệ', h: '#contact' },
];
const connect = [
  { t: 'Email', h: `mailto:${email}`, ext: false },
  ...socials.filter((s) => s.h).map((s) => ({ t: s.t, h: s.h, ext: true })),
];
const word = 'coreSpark'.split('');
---

<footer class="foot" id="footer">
  <!-- Lớp tia lửa phủ toàn footer, không chặn chuột -->
  <canvas class="foot__sparks" aria-hidden="true"></canvas>

  <div class="foot__top">
    <div class="foot__cta">
      <p class="foot__eyebrow"><span class="foot__live" aria-hidden="true"></span>Đang nhận dự án mới</p>
      <h2 class="foot__ask">Có một ý tưởng?<br />Đốt tia lửa đầu tiên.</h2>
      <a class="foot__mail" href={`mailto:${email}`}>
        <span>{email}</span><i aria-hidden="true">↗</i>
      </a>
    </div>

    <nav class="foot__cols" aria-label="Chân trang">
      <div class="foot__col">
        <h3>Khám phá</h3>
        <ul>
          {explore.map((l) => <li><a class="foot__link" href={l.h}>{l.t}</a></li>)}
        </ul>
      </div>
      <div class="foot__col">
        <h3>Kết nối</h3>
        <ul>
          {connect.map((l) => (
            <li>
              <a class="foot__link" href={l.h} target={l.ext ? '_blank' : undefined} rel={l.ext ? 'noopener' : undefined}>{l.t}</a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>

  <!-- Chữ khổng lồ: mỗi chữ cái là một span để JS cho chuyển động riêng -->
  <div class="mark" role="img" aria-label="coreSpark">
    {word.map((ch, i) => <span class="mark__l" style={`--i:${i}`} aria-hidden="true">{ch}</span>)}
  </div>

  <div class="foot__bar">
    <p class="foot__copy">© {year} coreSpark. Mọi quyền được bảo lưu.</p>

    <!-- Ghi công: nhỏ, xám, link đậm dần khi rê chuột, mũi tên trượt ra -->
    <p class="foot__credit">
      Thiết kế &amp; lập trình bởi
      <a class="credit" href={site} target="_blank" rel="noopener">duyanh.dev<i aria-hidden="true">↗</i></a>
    </p>

    <p class="foot__clock"><span>Sài Gòn</span><time class="foot__time">--:--:--</time></p>
    <p class="foot__hint">
      <span class="foot__hint--fine">Rê chuột qua chữ, bấm bất kỳ đâu để bắn tia lửa</span>
      <span class="foot__hint--touch">Chạm vào chữ, chạm bất kỳ đâu để bắn tia lửa</span>
      <b class="foot__count" aria-live="off">0</b>
    </p>
    <button class="foot__up" type="button" aria-label="Về đầu trang"><span aria-hidden="true">↑</span></button>
  </div>
</footer>

<style>
  .foot {
    position: relative; overflow: clip;
    background: #f5f5f7; color: #1d1d1f;
    padding-top: clamp(4rem, 9vw, 7rem);
  }
  .foot__sparks { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 3; }

  /* --- Phần trên: lời mời + cột link --- */
  .foot__top {
    position: relative; z-index: 2;
    display: grid; grid-template-columns: 1.4fr 1fr; gap: 4vw; align-items: start;
    padding: 0 var(--gutter, 1.5rem);
  }
  .foot__eyebrow { display: inline-flex; align-items: center; gap: .6rem; margin-bottom: 1.2rem; font-size: .9rem; font-weight: 600; color: #6e6e73; }
  .foot__live { position: relative; width: .55rem; height: .55rem; border-radius: 50%; background: #30d158; }
  .foot__live::after { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid #30d158; animation: ping 1.8s ease-out infinite; }
  @keyframes ping { from { transform: scale(1); opacity: .9; } to { transform: scale(3.2); opacity: 0; } }

  .foot__ask { font-size: clamp(2rem, 5.2vw, 4.2rem); line-height: 1.04; letter-spacing: -.035em; font-weight: 700; }

  /* Nút email: --mx/--my do JS gán để nút "hút" theo chuột */
  .foot__mail {
    display: inline-flex; align-items: center; gap: .7rem; margin-top: 1.8rem;
    padding: .95rem 1.6rem; border-radius: 999px;
    background: #0a84ff; color: #fff; font-weight: 600; font-size: 1.05rem;
    transform: translate(var(--mx, 0), var(--my, 0)) scale(var(--sc, 1));
    transition: transform .25s ease-out, background .25s;
  }
  .foot__mail i { font-style: normal; display: inline-block; transition: transform .3s cubic-bezier(.2, .9, .3, 1.4); }
  .foot__mail:hover { --sc: 1.05; background: #0071e3; }
  .foot__mail:hover i { transform: translate(3px, -3px) rotate(8deg); }
  .foot__mail:active { --sc: .96; }

  .foot__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; padding-top: .4rem; }
  .foot__col h3 { margin-bottom: .9rem; font-size: .8rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: #6e6e73; }
  .foot__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
  .foot__link { position: relative; font-size: 1.15rem; font-weight: 500; color: #1d1d1f; transition: color .25s; }
  .foot__link::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: currentColor;
    transform: scaleX(0); transform-origin: left; transition: transform .35s cubic-bezier(.2, .9, .3, 1);
  }
  .foot__link:hover { color: #0a84ff; }
  .foot__link:hover::after { transform: scaleX(1); }

  /* --- Chữ khổng lồ --- */
  .mark {
    position: relative; z-index: 2;
    display: flex; justify-content: center;
    margin-top: clamp(2rem, 5vw, 4rem); padding: clamp(2.2rem, 6vw, 4.5rem) 0 1rem;
    font-size: clamp(3.4rem, 18.4vw, 19rem); font-weight: 800; letter-spacing: -.065em; line-height: .85;
    white-space: nowrap; user-select: none; -webkit-user-select: none;
    overflow-x: clip; touch-action: pan-y;
  }
  .mark__l {
    display: inline-block; color: #1d1d1f; transform-origin: 50% 85%;
    will-change: transform; transition: color .2s;
  }
  .mark__l.hot { color: var(--lc); }

  /* --- Thanh dưới cùng --- */
  .foot__bar {
    position: relative; z-index: 2;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .8rem 1.5rem;
    margin: 0 var(--gutter, 1.5rem); padding: 1.3rem 0 1.8rem;
    border-top: 1px solid #d2d2d7; font-size: .88rem; color: #6e6e73;
  }
  .foot__bar p { margin: 0; }

  /* Ghi công duyanh.dev: kiểu dòng bản quyền của Apple, nhỏ, xám, không nhãn dán */
  .foot__credit { display: inline-flex; align-items: baseline; gap: .35rem; flex-wrap: wrap; }
  .credit {
    position: relative; display: inline-flex; align-items: baseline; gap: .2rem;
    color: #1d1d1f; font-weight: 500; letter-spacing: -.005em;
    text-decoration: underline; text-decoration-color: transparent;
    text-underline-offset: .22em; text-decoration-thickness: 1px;
    transition: color .25s, text-decoration-color .25s;
  }
  .credit i {
    font-style: normal; font-size: .85em; color: #0071e3;
    opacity: 0; transform: translate(-3px, 3px);
    transition: opacity .25s, transform .3s cubic-bezier(.2, .9, .3, 1);
  }
  .credit:hover, .credit:focus-visible { color: #0071e3; text-decoration-color: currentColor; }
  .credit:hover i, .credit:focus-visible i { opacity: 1; transform: none; }
  .credit:focus-visible { outline: 2px solid #0071e3; outline-offset: 3px; border-radius: 4px; }

  .foot__clock { display: inline-flex; gap: .5rem; align-items: baseline; }
  .foot__time { font-variant-numeric: tabular-nums; color: #1d1d1f; font-weight: 600; }

  .foot__hint { display: inline-flex; gap: .6rem; align-items: center; }
  .foot__hint--touch { display: none; }
  @media (hover: none) { .foot__hint--fine { display: none; } .foot__hint--touch { display: inline; } }
  .foot__count {
    min-width: 1.8rem; padding: .1rem .55rem; border-radius: 999px; text-align: center;
    background: #1d1d1f; color: #fff; font-variant-numeric: tabular-nums; font-size: .8rem;
  }

  .foot__up {
    width: 2.7rem; height: 2.7rem; border: 0; border-radius: 50%; padding: 0;
    background: #1d1d1f; color: #fff; font-size: 1.15rem; cursor: pointer;
    transition: transform .3s cubic-bezier(.2, .9, .3, 1.4), background .25s;
  }
  .foot__up:hover { transform: translateY(-4px); background: #0a84ff; }
  .foot__up:active { transform: scale(.92); }

  /* --- Điện thoại và tablet --- */
  @media (max-width: 800px) {
    .foot__top { grid-template-columns: 1fr; gap: 2.4rem; }
    .foot__bar { flex-direction: column; align-items: flex-start; }
    .foot__up { align-self: flex-end; margin-top: -3.4rem; }
    .mark { letter-spacing: -.07em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .foot__live::after { animation: none; }
    .foot__mail, .credit, .credit i, .foot__up { transition: none; }
  }
</style>

<script>
  const foot = document.querySelector('.foot');
  const cv = foot.querySelector('.foot__sparks');
  const ctx = cv.getContext('2d');
  const mark = foot.querySelector('.mark');
  const letters = Array.from(mark.querySelectorAll('.mark__l'));
  const countEl = foot.querySelector('.foot__count');
  const timeEl = foot.querySelector('.foot__time');
  const mail = foot.querySelector('.foot__mail');
  const upBtn = foot.querySelector('.foot__up');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Màu hệ thống phẳng (cùng bảng màu với toàn trang)
  const PAL = ['#0a84ff', '#bf5af2', '#ff375f', '#ff9f0a', '#30d158'];

  /* ---------- Kích thước canvas + vị trí gốc của từng chữ ---------- */
  let W = 0, H = 0, dpr = 1;
  let base = [];
  function measure() {
    const r = foot.getBoundingClientRect();
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = r.width; H = r.height;
    cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    // offsetLeft/Top không bị ảnh hưởng bởi transform nên đo được vị trí gốc
    base = letters.map((l) => ({ cx: l.offsetLeft + l.offsetWidth / 2, cy: l.offsetTop + l.offsetHeight / 2 }));
  }
  measure();
  new ResizeObserver(measure).observe(foot);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);

  /* ---------- Trạng thái lò xo của từng chữ ---------- */
  const L = letters.map(() => ({ x: 0, y: 0, vx: 0, vy: 0, r: 0, vr: 0, s: 1, hot: false }));
  let ptr = null;                  // vị trí con trỏ (toạ độ viewport) khi đang ở trong footer
  const particles = [];
  let raf = 0, visible = false, count = 0;

  /* ---------- Tia lửa ---------- */
  function burst(x, y, n, power) {
    if (reduce) return;
    for (let i = 0; i < n; i++) {
      const a = Math.random() * Math.PI * 2;
      const sp = (2 + Math.random() * 6) * power;
      particles.push({
        x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - 2 * power,
        t: 0, life: 38 + Math.random() * 38,
        c: PAL[(Math.random() * PAL.length) | 0],
        line: Math.random() < 0.45,
        r: 3 + Math.random() * 4,
      });
    }
    kick();
  }

  /* ---------- Vòng lặp: chỉ chạy khi footer đang hiện và còn gì đó để cử động ---------- */
  function tick() {
    raf = 0;
    const mr = mark.getBoundingClientRect();
    const R = Math.max(120, mr.height * 1.15);   // bán kính ảnh hưởng của con trỏ
    let moving = false;

    letters.forEach((el, i) => {
      const s = L[i], b = base[i];
      let tx = 0, ty = 0, tr = 0, ts = 1, f = 0;
      if (ptr && !reduce && b) {
        const dx = mr.left + b.cx - ptr.x;
        const dy = mr.top + b.cy - ptr.y;
        const d = Math.hypot(dx, dy) || 1;
        if (d < R) {
          f = (1 - d / R); f *= f;
          tx = (dx / d) * f * R * 0.28;      // đẩy ra xa con trỏ
          ty = -f * mr.height * 0.32;        // nhấc lên
          tr = (dx / R) * f * 18;            // nghiêng
          ts = 1 + f * 0.22;                 // phình ra
        }
      }
      // Lò xo: gia tốc về đích, ma sát giữ độ nảy
      s.vx += (tx - s.x) * 0.14; s.vx *= 0.76; s.x += s.vx;
      s.vy += (ty - s.y) * 0.14; s.vy *= 0.76; s.y += s.vy;
      s.vr += (tr - s.r) * 0.14; s.vr *= 0.76; s.r += s.vr;
      s.s += (ts - s.s) * 0.2;
      el.style.transform = `translate(${s.x.toFixed(2)}px, ${s.y.toFixed(2)}px) rotate(${s.r.toFixed(2)}deg) scale(${s.s.toFixed(3)})`;

      const hot = f > 0.12;
      if (hot) el.style.setProperty('--lc', PAL[i % PAL.length]);
      if (hot !== s.hot) { s.hot = hot; el.classList.toggle('hot', hot); }
      if (f > 0 || Math.abs(s.x) + Math.abs(s.y) + Math.abs(s.r) + Math.abs(s.vx) + Math.abs(s.vy) + Math.abs(s.vr) > 0.05) moving = true;
    });

    // Vẽ tia lửa: chấm tròn và vạch ngắn, màu đặc, mờ dần
    ctx.clearRect(0, 0, W, H);
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.vy += 0.14; p.vx *= 0.985; p.vy *= 0.985;
      p.x += p.vx; p.y += p.vy; p.t++;
      const k = p.t / p.life;
      if (k >= 1) { particles.splice(i, 1); continue; }
      ctx.globalAlpha = 1 - k;
      ctx.fillStyle = p.c; ctx.strokeStyle = p.c;
      if (p.line) {
        ctx.lineWidth = 3; ctx.lineCap = 'round';
        ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(p.x - p.vx * 2.2, p.y - p.vy * 2.2); ctx.stroke();
      } else {
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r * (1 - k * 0.6), 0, Math.PI * 2); ctx.fill();
      }
    }
    ctx.globalAlpha = 1;

    if (visible && (moving || particles.length || ptr)) raf = requestAnimationFrame(tick);
  }
  function kick() { if (!raf && visible) raf = requestAnimationFrame(tick); }

  new IntersectionObserver((entries) => {
    visible = entries[0].isIntersecting;
    if (visible) kick(); else if (raf) { cancelAnimationFrame(raf); raf = 0; }
  }).observe(foot);

  /* ---------- Con trỏ ---------- */
  let last = null;
  foot.addEventListener('pointermove', (e) => {
    // Đang rê trên link / nút (kể cả dòng duyanh.dev): không bắn tia lửa, chữ khổng lồ cũng đứng yên
    if (e.target.closest('a, button')) { ptr = null; last = null; kick(); return; }
    ptr = { x: e.clientX, y: e.clientY };
    // Rê nhanh qua chữ thì rơi vài tia lửa nhỏ
    const mr = mark.getBoundingClientRect();
    const over = e.clientY > mr.top && e.clientY < mr.bottom;
    if (over && last && Math.hypot(e.clientX - last.x, e.clientY - last.y) > 14 && Math.random() < 0.5) {
      const fr = foot.getBoundingClientRect();
      burst(e.clientX - fr.left, e.clientY - fr.top, 1, 0.35);
    }
    last = { x: e.clientX, y: e.clientY };
    kick();
  });
  foot.addEventListener('pointerleave', () => { ptr = null; last = null; kick(); });
  foot.addEventListener('pointerup', (e) => { if (e.pointerType === 'touch') setTimeout(() => { ptr = null; kick(); }, 450); });

  /* ---------- Bấm: tia lửa + chữ giật nảy ---------- */
  foot.addEventListener('pointerdown', (e) => {
    if (e.target.closest('a, button')) return;
    const fr = foot.getBoundingClientRect();
    ptr = { x: e.clientX, y: e.clientY };
    burst(e.clientX - fr.left, e.clientY - fr.top, 22, 1);

    const mr = mark.getBoundingClientRect();
    const R = Math.max(120, mr.height * 1.15) * 1.6;
    letters.forEach((el, i) => {
      const b = base[i]; if (!b) return;
      const dx = mr.left + b.cx - e.clientX, dy = mr.top + b.cy - e.clientY;
      const f = 1 - Math.min(1, Math.hypot(dx, dy) / R);
      if (f > 0 && !reduce) { L[i].vy -= f * 30; L[i].vr += (dx >= 0 ? 1 : -1) * f * 6; }
    });

    count++;
    countEl.textContent = String(count);
    // Cứ 10 lần là một trận pháo hoa trên chữ
    if (count % 10 === 0) {
      for (let k = 0; k < 5; k++) {
        setTimeout(() => burst(Math.random() * W, mark.offsetTop + Math.random() * mark.offsetHeight, 26, 1.2), k * 140);
      }
    }
    kick();
  });

  /* ---------- Nút email "từ tính": hút nhẹ về phía con trỏ khi lại gần ---------- */
  if (window.matchMedia('(pointer: fine)').matches && !reduce) {
    foot.addEventListener('pointermove', (e) => {
      const r = mail.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width / 2);
      const dy = e.clientY - (r.top + r.height / 2);
      if (Math.hypot(dx, dy) < 130) {
        mail.style.setProperty('--mx', `${(dx * 0.25).toFixed(1)}px`);
        mail.style.setProperty('--my', `${(dy * 0.35).toFixed(1)}px`);
      } else {
        mail.style.removeProperty('--mx'); mail.style.removeProperty('--my');
      }
    });
    foot.addEventListener('pointerleave', () => { mail.style.removeProperty('--mx'); mail.style.removeProperty('--my'); });
  }

  /* ---------- Về đầu trang (dùng Lenis nếu có) ---------- */
  upBtn.addEventListener('click', () => {
    const fr = foot.getBoundingClientRect(), br = upBtn.getBoundingClientRect();
    burst(br.left - fr.left + br.width / 2, br.top - fr.top + br.height / 2, 26, 1.1);
    if (window.__lenis) window.__lenis.scrollTo(0, { duration: 1.4 });
    else window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  /* ---------- Đồng hồ Sài Gòn ---------- */
  const fmt = new Intl.DateTimeFormat('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
  const tickClock = () => { timeEl.textContent = fmt.format(new Date()); };
  tickClock();
  setInterval(tickClock, 1000);
</script>