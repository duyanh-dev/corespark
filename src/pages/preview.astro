---
/* =========================================================
   PREVIEW.ASTRO - Trang xem demo đầy đủ (dùng khi khung xem ở trang chính dễ crash trên điện thoại)
   - Thanh kính nổi (liquid glass phẳng, không gradient): Máy tính / Điện thoại, trước / sau, tải lại, copy link, Visit site
   - Chỉ có DUY NHẤT một iframe tại một thời điểm; đổi tab / đổi demo là gỡ iframe cũ trước khi nạp cái mới
   - Trên điện thoại: đổi tab = nạp lại cả trang với viewport tương ứng (giải phóng toàn bộ RAM, an toàn nhất)
   - Có "chốt chống crash": nếu lần trước nạp demo mà trang bị iOS kill, lần mở lại sẽ chờ bấm mới nạp
   - Tab Máy tính: điện thoại hiện trang rộng 1280, trình duyệt PC dựng web ở 1440 rồi thu vừa khung => thấy tối đa chi tiết
   Đặt tại src/pages/preview.astro (nếu để src/pages/preview/index.astro thì đổi import thành ../../data/demos.json)
   ========================================================= */
import raw from '../data/demos.json';
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (u) => (u && u.startsWith('/') && !u.startsWith('//') ? base + u : u);

/* Cùng quy tắc chọn nguồn như Showcase.astro: localUrl (có file thật trong public/) được ưu tiên */
const PUBLIC_DIR = path.join(process.cwd(), 'public');
function localExists(localUrl) {
  if (!localUrl || /^https?:/i.test(localUrl)) return false;
  let p = localUrl.split(/[?#]/)[0];
  try { p = decodeURI(p); } catch {}
  if (p.endsWith('/')) p += 'index.html';
  const file = path.normalize(path.join(PUBLIC_DIR, p));
  try { return file.startsWith(PUBLIC_DIR) && fs.statSync(file).isFile(); }
  catch { return false; }
}

const demos = raw
  .map((d) => {
    const url = localExists(d.localUrl) ? d.localUrl : (d.url ?? d.localUrl);
    return {
      slug: d.slug, title: d.title, type: d.type, topic: d.topic, date: d.date,
      thumb: withBase(d.thumb),
      url: withBase(url),
      siteUrl: withBase(d.siteUrl ?? d.url ?? d.localUrl),
    };
  })
  .sort((a, b) => b.date.localeCompare(a.date));

const dataJson = JSON.stringify(demos).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=1280, minimum-scale=0.2, maximum-scale=3" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#0b0b0d" />
  <meta name="robots" content="noindex" />
  <title>Xem demo</title>

  <!-- Chọn viewport TRƯỚC khi vẽ: điện thoại + tab Máy tính = trang rộng 1280 (có thể zoom). Tab Điện thoại = viewport thật -->
  <script is:inline>
    (function () {
      var q = new URLSearchParams(location.search);
      var phone = matchMedia('(pointer: coarse)').matches && Math.min(screen.width, screen.height) < 700;
      if (phone && q.get('d') === 'mobile') {
        document.querySelector('meta[name=viewport]').setAttribute('content', 'width=device-width, initial-scale=1');
      }
    })();
  </script>

  <style is:global>
    html, body { margin: 0; height: 100%; overflow: hidden; background: #0b0b0d; color: #f5f5f7;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Inter", system-ui, sans-serif;
      -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: 100%; }
    button { font: inherit; color: inherit; border: 0; background: none; padding: 0; cursor: pointer; -webkit-tap-highlight-color: transparent; }
    a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }
    svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    /* ---------- Khung tổng: cột dọc [thanh trên] [sân khấu] [thanh dưới] ----------
       Khoảng cách nhân với --k để khi điện thoại hiện trang rộng 1280 vẫn có lề/khe đúng cỡ thật */
    .pv { --k: 1; position: fixed; inset: 0; display: flex; flex-direction: column; gap: calc(10px * var(--k)); overflow: hidden; background: #0b0b0d;
      padding: calc(12px * var(--k) + env(safe-area-inset-top)) calc(12px * var(--k)) calc(12px * var(--k) + env(safe-area-inset-bottom)); }
    .pv > * { position: relative; z-index: 1; }

    /* ---------- Vật liệu kính (phẳng, không gradient) ----------
       Thanh KHÔNG nằm đè lên iframe nên backdrop-filter không tốn GPU như khi đè lên demo đang chuyển động.
       Độ nổi khối đến từ viền sáng + highlight cạnh trên + bóng đổ, không dùng dải màu */
    .glass { border-radius: 28px; background: rgba(255, 255, 255, .07);
      -webkit-backdrop-filter: blur(30px) saturate(170%); backdrop-filter: blur(30px) saturate(170%);
      border: 1px solid rgba(255, 255, 255, .14);
      box-shadow: 0 10px 32px rgba(0, 0, 0, .38), inset 0 1px 0 rgba(255, 255, 255, .24), inset 0 -1px 0 rgba(255, 255, 255, .05); }

    /* ---------- Thanh trên ---------- */
    .bar { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto auto; grid-template-areas: "bk ttl seg tools visit";
      align-items: center; column-gap: 12px; row-gap: 8px; padding: 8px 10px; zoom: var(--k); }

    .ibtn { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
      background: rgba(255, 255, 255, .1); border: 1px solid rgba(255, 255, 255, .16);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .22); transition: background .2s, transform .2s, opacity .2s; }
    .ibtn:hover { background: rgba(255, 255, 255, .2); }
    .ibtn:active { transform: scale(.92); }
    .ibtn:disabled { opacity: .3; cursor: default; transform: none; }
    .ibtn svg { width: 18px; height: 18px; }
    .bk { grid-area: bk; }

    .ttl { grid-area: ttl; min-width: 0; line-height: 1.25; }
    .ttl strong, .ttl span { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ttl strong { font-size: 16px; font-weight: 600; letter-spacing: -.01em; }
    .ttl span { font-size: 12.5px; color: #aeaeb2; }

    /* Công tắc thiết bị: đường ray tối, viên trắng trượt qua lại */
    .seg { grid-area: seg; position: relative; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; padding: 3px; border-radius: 999px;
      background: rgba(0, 0, 0, .28); border: 1px solid rgba(255, 255, 255, .12); box-shadow: inset 0 1px 2px rgba(0, 0, 0, .35); }
    .seg i { position: absolute; top: 3px; bottom: 3px; left: 3px; width: calc((100% - 6px) / 2); border-radius: 999px;
      background: rgba(255, 255, 255, .95); box-shadow: 0 2px 8px rgba(0, 0, 0, .35);
      transition: transform .38s cubic-bezier(.3, 1.25, .5, 1); }
    .seg[data-d="mobile"] i { transform: translateX(100%); }
    .seg button { position: relative; display: inline-flex; align-items: center; justify-content: center; padding: 8px 16px; border-radius: 999px;
      font-size: 13.5px; font-weight: 500; line-height: 1.2; color: #d1d1d6; white-space: nowrap; transition: color .25s; }
    .seg button.is-active { color: #1d1d1f; }

    /* Cụm công cụ: một viên thuốc kính chứa 4 nút tròn không viền */
    .tools { grid-area: tools; display: flex; align-items: center; gap: 2px; padding: 3px; border-radius: 999px;
      background: rgba(255, 255, 255, .07); border: 1px solid rgba(255, 255, 255, .12); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .14); }
    .tools .ibtn { width: 34px; height: 34px; background: transparent; border-color: transparent; box-shadow: none; }
    .tools .ibtn:hover { background: rgba(255, 255, 255, .16); }
    .tools .ibtn svg { width: 17px; height: 17px; }

    .visit { grid-area: visit; display: inline-flex; align-items: center; justify-content: center; gap: 5px; height: 40px; padding: 0 18px; border-radius: 999px; white-space: nowrap;
      background: rgba(10, 132, 255, .92); border: 1px solid rgba(255, 255, 255, .3);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .4), 0 6px 18px rgba(10, 132, 255, .3);
      font-size: 14px; font-weight: 600; transition: transform .2s; }
    .visit:hover { transform: scale(1.04); }
    .visit:active { transform: scale(.96); }

    /* ---------- Sân khấu + khung thiết bị ---------- */
    .stage { flex: 1; min-height: 0; display: grid; place-items: center; }
    .frame { position: relative; width: 100%; height: 100%; overflow: hidden; background: #000; border-radius: 18px;
      box-shadow: 0 40px 100px -30px rgba(0, 0, 0, .85), 0 0 0 1px rgba(255, 255, 255, .12); contain: layout paint; }
    .frame.pop { animation: pv-pop .4s cubic-bezier(.2, .8, .2, 1); }
    @keyframes pv-pop { from { opacity: 0; transform: scale(.97); } }
    .scr { position: absolute; inset: 0; overflow: hidden; background: #fff; border-radius: inherit; }
    .scr iframe { position: absolute; left: 0; top: 0; border: 0; background: #fff; transform-origin: 0 0; opacity: 0; transition: opacity .4s; }
    .scr iframe.is-loaded { opacity: 1; }

    /* Tab Điện thoại trên máy tính: khung máy 390 x 844 có viền */
    .pv[data-device="mobile"] .frame { width: min(414px, 100%); height: min(868px, 100%); padding: 12px; border-radius: 52px; background: #050506;
      box-shadow: 0 40px 100px -30px rgba(0, 0, 0, .85), 0 0 0 1px rgba(255, 255, 255, .16), inset 0 0 0 2px #2a2a2e; }
    .pv[data-device="mobile"] .scr { inset: 12px; border-radius: 40px; }
    /* Tab Điện thoại trên chính điện thoại: không cần khung giả, dùng nguyên màn hình thật */
    .pv.is-native .frame { width: 100%; height: 100%; padding: 0; border-radius: 22px; box-shadow: 0 0 0 1px rgba(255, 255, 255, .12); }
    .pv.is-native .scr { inset: 0; border-radius: 22px; }

    /* Màn hình chờ */
    .loader { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; background: #1c1c1e var(--thumb, none) center top / cover no-repeat; transition: opacity .4s, visibility 0s; }
    .loader::before { content: ''; position: absolute; inset: 0; background: rgba(0, 0, 0, .5); }
    .loader.is-done { opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .4s, visibility 0s .4s; }
    .spin { position: relative; width: 32px; height: 32px; border: 3px solid rgba(255, 255, 255, .22); border-top-color: #fff; border-radius: 50%; animation: pv-rot .8s linear infinite; zoom: var(--k); }
    @keyframes pv-rot { to { transform: rotate(360deg); } }
    .wait { display: none; position: relative; max-width: 86%; padding: 11px 22px; border-radius: 999px; background: rgba(255, 255, 255, .95); color: #1d1d1f; font-size: 15px; font-weight: 600; line-height: 1.3; text-align: center; box-shadow: 0 8px 28px rgba(0, 0, 0, .35); zoom: var(--k); }
    .loader.is-wait .spin { display: none; }
    .loader.is-wait .wait { display: block; }

    /* ---------- Thanh dưới ---------- */
    .foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 8px 8px 8px 22px; zoom: var(--k); }
    .hint { margin: 0; font-size: 13px; line-height: 1.45; color: #d1d1d6; }
    .hint b { color: #fff; font-weight: 600; }
    .hint.is-warn { color: #ffd60a; }
    .hint.is-warn b { color: #ffd60a; }
    .want { flex: none; height: 42px; padding: 0 22px; border-radius: 999px; background: rgba(255, 255, 255, .95); color: #1d1d1f; font-size: 14.5px; font-weight: 600; white-space: nowrap;
      box-shadow: 0 2px 10px rgba(0, 0, 0, .25); transition: transform .2s; }
    .want:hover { transform: scale(1.04); }
    .want:active { transform: scale(.97); }

    .toast { position: absolute; left: 50%; bottom: 96px; z-index: 5; padding: 8px 16px; border-radius: 999px; background: rgba(255, 255, 255, .95); color: #1d1d1f;
      font-size: 13.5px; font-weight: 600; white-space: nowrap; opacity: 0; pointer-events: none; transform: translate(-50%, 10px); transition: opacity .25s, transform .25s; zoom: var(--k); }
    .toast.is-on { opacity: 1; transform: translate(-50%, 0); }

    /* ---------- Chế độ gọn (điện thoại) ----------
       Dùng class .is-compact do JS bật theo bề rộng THẬT (innerWidth / --k), vì khi điện thoại hiện trang rộng 1280
       thì media query không còn đúng. Hai hàng: [quay lại | tên demo | Visit] và [công tắc thiết bị | công cụ] */
    .pv.is-compact .bar { grid-template-columns: auto minmax(0, 1fr) auto; grid-template-areas: "bk ttl visit" "seg seg tools";
      column-gap: 8px; row-gap: 8px; padding: 8px; border-radius: 24px; }
    .pv.is-compact .ibtn { width: 36px; height: 36px; }
    .pv.is-compact .tools .ibtn { width: 32px; height: 32px; }
    .pv.is-compact .tools .ibtn svg { width: 16px; height: 16px; }
    .pv.is-compact .ttl strong { font-size: 14.5px; }
    .pv.is-compact .ttl span { font-size: 11.5px; }
    .pv.is-compact .seg { justify-self: stretch; }
    .pv.is-compact .seg button { padding: 8px 6px; font-size: 13px; }
    .pv.is-compact .tools { justify-self: end; }
    .pv.is-compact .visit { justify-self: stretch; height: 36px; padding: 0 14px; font-size: 13px; }
    .pv.is-compact .frame { border-radius: 20px; }

    .pv.is-compact .foot { flex-direction: column; align-items: stretch; gap: 10px; padding: 12px; border-radius: 24px; }
    .pv.is-compact .hint { font-size: 12px; text-align: left; }
    .pv.is-compact .want { width: 100%; height: 44px; font-size: 15px; }
    .pv.is-compact .toast { bottom: 150px; }

    /* Điện thoại nằm ngang (thấp): ẩn thanh dưới để dành chỗ cho demo */
    .pv.is-short .foot { display: none; }
  </style>
</head>
<body>
  <div class="pv" id="pv" data-device="desktop">
    <header class="bar glass" id="bar">
      <button class="ibtn bk" id="back" type="button" aria-label="Quay lại (Esc)"><svg viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6" /></svg></button>

      <div class="ttl"><strong id="title"></strong><span id="meta"></span></div>

      <div class="seg" id="seg" data-d="desktop" role="group" aria-label="Chọn thiết bị">
        <i aria-hidden="true"></i>
        <button type="button" data-d="desktop" class="is-active">Máy tính</button>
        <button type="button" data-d="mobile">Điện thoại</button>
      </div>

      <div class="tools">
        <button class="ibtn" id="prev" type="button" aria-label="Demo trước (←)"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg></button>
        <button class="ibtn" id="next" type="button" aria-label="Demo sau (→)"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg></button>
        <button class="ibtn" id="reload" type="button" aria-label="Tải lại"><svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.3-5.7M20 4v5h-5" /></svg></button>
        <button class="ibtn" id="copy" type="button" aria-label="Sao chép link demo"><svg viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg></button>
      </div>

      <a class="visit" id="visit" href="#" target="_blank" rel="noopener noreferrer">Visit site ↗</a>
    </header>

    <main class="stage" id="stage">
      <div class="frame" id="frame">
        <div class="scr" id="scr">
          <div class="loader" id="loader">
            <span class="spin"></span>
            <button class="wait" id="wait" type="button">Nhấn để tải demo</button>
          </div>
        </div>
      </div>
    </main>

    <footer class="foot glass" id="foot">
      <p class="hint" id="hint">Đây là bản <b>demo xem nhanh</b>, một số chi tiết có thể chưa hiển thị đầy đủ hoặc không cho nhúng. Để xem kỹ toàn bộ site, vui lòng bấm <b>Visit site</b> và xem trên <b>thiết bị thật</b>.</p>
      <button class="want" id="want" type="button">Tôi muốn web như này</button>
    </footer>

    <div class="toast" id="toast" role="status"></div>
  </div>

  <script is:inline type="application/json" id="pv-data" set:html={dataJson}></script>

  <script is:inline define:vars={{ base }}>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var root = $('pv'), scr = $('scr'), frame = $('frame'), stage = $('stage'), loader = $('loader');
      var hint = $('hint'), toast = $('toast'), seg = $('seg'), waitBtn = $('wait');
      var prevBtn = $('prev'), nextBtn = $('next');
      var devBtns = Array.prototype.slice.call(seg.querySelectorAll('button'));

      var SANDBOX = 'allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-modals';
      var DESK_VP = 1280;   // bề rộng viewport khi điện thoại xem tab Máy tính (khớp thẻ meta viewport)
      var DESK_W = 1440;    // bề rộng dựng web ở tab Máy tính trên trình duyệt PC (rồi thu nhỏ vừa khung)
      var demos = JSON.parse($('pv-data').textContent);
      var q = new URLSearchParams(location.search);
      var u = q.get('u') || '';
      var validU = /^\/(?!\/)[^\\]*$/.test(u);                       // chỉ nhận đường dẫn nội bộ
      var phone = matchMedia('(pointer: coarse)').matches && Math.min(screen.width, screen.height) < 700;
      var device = q.get('d') === 'mobile' ? 'mobile' : 'desktop';

      var iframe = null, hintT = 0, loadT = 0, toastT = 0, rafL = 0, waitMode = 'load';

      var abs = function (x) { return new URL(x, location.href).href; };
      var norm = function (s) { return (s || '').replace(/\/$/, ''); };
      var keyOf = function (x) {
        try { var a = new URL(x, location.origin); return a.origin === location.origin ? a.pathname + a.search : null; }
        catch (e) { return null; }
      };

      /* ----- Demo hiện tại: khớp theo đường dẫn ?u= với danh sách để có trước/sau, thumbnail, loại... ----- */
      var idx = demos.findIndex(function (d) { var k = keyOf(d.url); return k !== null && norm(k) === norm(u); });
      var cur = idx >= 0 ? demos[idx]
        : (validU ? { slug: '', title: q.get('t') || 'Demo', type: '', topic: '', thumb: '', url: u, siteUrl: u } : null);

      /* ---------- Hệ số bù khi điện thoại hiện trang rộng 1280: phóng thanh công cụ lên cho bấm được ---------- */
      function calcK() {
        if (!(phone && device === 'desktop')) return 1;
        var portrait = matchMedia('(orientation: portrait)').matches;
        var w = portrait ? Math.min(screen.width, screen.height) : Math.max(screen.width, screen.height);
        return Math.max(1, DESK_VP / w);
      }
      function applyMode() {
        var k = calcK();
        root.style.setProperty('--k', k);
        root.dataset.device = device;
        root.classList.toggle('is-native', phone && device === 'mobile');
        /* Bề rộng/cao "thật" mà thanh công cụ nhìn thấy (đã trừ hệ số zoom) => quyết định bố cục gọn */
        var effW = window.innerWidth / k, effH = window.innerHeight / k;
        root.classList.toggle('is-compact', effW < 700);
        root.classList.toggle('is-short', effH < 520 && window.innerWidth > window.innerHeight);
        seg.dataset.d = device;
        devBtns.forEach(function (b) { b.classList.toggle('is-active', b.dataset.d === device); });
      }

      /* ---------- Điền thông tin lên thanh trên ---------- */
      function fill() {
        $('title').textContent = cur ? cur.title : 'Không tìm thấy demo';
        $('meta').textContent = cur ? [cur.type, cur.topic].filter(Boolean).join(' · ') : '';
        $('visit').href = cur ? abs(cur.siteUrl || cur.url) : '#';
        loader.style.setProperty('--thumb', cur && cur.thumb ? 'url("' + abs(cur.thumb) + '")' : 'none');
        prevBtn.disabled = nextBtn.disabled = !(idx >= 0 && demos.length > 1);
        hint.classList.remove('is-warn');
        if (cur) document.title = cur.title;
      }

      /* Giữ URL khớp demo / thiết bị đang xem (tải lại trang vẫn đúng chỗ) */
      function syncUrl() {
        var k = cur && keyOf(cur.url);
        if (!k) return;
        var p = new URLSearchParams({ u: k, t: cur.title });
        if (device === 'mobile') p.set('d', 'mobile');
        history.replaceState(null, '', '?' + p.toString());
      }

      /* ---------- Gỡ iframe: giải phóng RAM, dừng WebGL ---------- */
      function kill() {
        clearTimeout(hintT); clearTimeout(loadT);
        try { sessionStorage.removeItem('pv:loading'); } catch (e) {}
        if (!iframe) return;
        iframe.src = 'about:blank';
        iframe.remove();
        iframe = null;
      }

      /* ---------- Đặt kích thước iframe ----------
         Máy tính (trình duyệt PC) hẹp hơn DESK_W: dựng trang DESK_W rồi thu nhỏ vừa khung.
         Các trường hợp còn lại: iframe lấp đầy khung (điện thoại đã có viewport 1280 hoặc viewport thật rồi) */
      function layout() {
        if (!iframe) return;
        var sw = scr.clientWidth, sh = scr.clientHeight;
        if (sw <= 0 || sh <= 0) return;
        if (device === 'desktop' && !phone && sw < DESK_W) {
          var s = sw / DESK_W;
          iframe.style.width = DESK_W + 'px';
          iframe.style.height = sh / s + 'px';
          iframe.style.transform = 'scale(' + s + ')';
        } else {
          iframe.style.width = '100%';
          iframe.style.height = '100%';
          iframe.style.transform = 'none';
        }
      }

      /* ---------- Nạp demo (luôn gỡ iframe cũ trước) ---------- */
      function load() {
        kill();
        if (!cur) return;
        loader.classList.remove('is-done', 'is-wait');
        iframe = document.createElement('iframe');
        iframe.title = cur.title;
        iframe.setAttribute('sandbox', SANDBOX);
        iframe.allow = 'fullscreen; autoplay';
        iframe.addEventListener('load', function () {
          try { sessionStorage.removeItem('pv:loading'); } catch (e) {}
          clearTimeout(hintT);
          loader.classList.add('is-done');
          iframe.classList.add('is-loaded');
        });
        scr.appendChild(iframe);
        layout();                                                       // có kích thước đúng rồi mới gán src
        try { sessionStorage.setItem('pv:loading', cur.url); } catch (e) {}   // chốt chống crash
        var x = new URL(abs(cur.url));
        if (x.origin === location.origin) x.searchParams.set('embed', '1');
        iframe.src = x.href;
        hintT = setTimeout(function () { hint.classList.add('is-warn'); }, 7000);
      }

      function showWait(text, mode) {
        waitMode = mode;
        waitBtn.textContent = text;
        loader.classList.remove('is-done');
        loader.classList.add('is-wait');
      }

      /* ---------- Đổi thiết bị ---------- */
      function setDevice(dev) {
        if (dev === device) return;
        if (phone) {
          /* Điện thoại: nạp lại cả trang với viewport mới => RAM được giải phóng hoàn toàn */
          kill();
          var p = new URLSearchParams(location.search);
          if (dev === 'mobile') p.set('d', 'mobile'); else p.delete('d');
          location.replace(location.pathname + '?' + p.toString());
          return;
        }
        device = dev;
        syncUrl();
        applyMode();
        kill();
        frame.classList.remove('pop'); void frame.offsetWidth; frame.classList.add('pop');
        loader.classList.remove('is-done');
        loadT = setTimeout(load, 120);
      }

      /* ---------- Demo trước / sau ---------- */
      function step(dir) {
        if (idx < 0 || demos.length < 2) return;
        idx = (idx + dir + demos.length) % demos.length;
        cur = demos[idx];
        fill(); syncUrl();
        kill();                                                         // gỡ demo cũ ngay
        loader.classList.remove('is-done', 'is-wait');
        loadT = setTimeout(load, 200);                                  // bấm liên tục chỉ nạp demo cuối
      }

      /* ---------- Toast, copy, quay lại ---------- */
      function showToast(msg) {
        toast.textContent = msg;
        toast.classList.add('is-on');
        clearTimeout(toastT);
        toastT = setTimeout(function () { toast.classList.remove('is-on'); }, 1800);
      }
      function copyLink() {
        if (!cur) return;
        var url = location.origin + base + '/' + (cur.slug ? '#demo=' + cur.slug : '');
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(function () { showToast('Đã sao chép link demo'); },
            function () { window.prompt('Sao chép link này:', url); });
        } else window.prompt('Sao chép link này:', url);
      }
      function goBack() {
        kill();
        if (history.length > 1 && document.referrer.indexOf(location.origin) === 0) history.back();
        else location.href = base + '/';
      }

      /* ---------- Sự kiện ---------- */
      $('back').addEventListener('click', goBack);
      prevBtn.addEventListener('click', function () { step(-1); });
      nextBtn.addEventListener('click', function () { step(1); });
      $('reload').addEventListener('click', function () { loader.classList.remove('is-done'); loadT = setTimeout(load, 60); });
      $('copy').addEventListener('click', copyLink);
      devBtns.forEach(function (b) { b.addEventListener('click', function () { setDevice(b.dataset.d); }); });
      waitBtn.addEventListener('click', function () { if (waitMode === 'back') goBack(); else load(); });

      /* "Tôi muốn web như này": lưu tên demo rồi về trang chính, phần Liên hệ */
      $('want').addEventListener('click', function () {
        if (cur) { try { sessionStorage.setItem('corespark:inquiry', JSON.stringify({ slug: cur.slug, title: cur.title })); } catch (e) {} }
        kill();
        location.href = base + '/#contact';
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { e.preventDefault(); goBack(); }
        else if (e.key === 'ArrowLeft') step(-1);
        else if (e.key === 'ArrowRight') step(1);
        else if (e.key === '1') setDevice('desktop');
        else if (e.key === '2') setDevice('mobile');
      });

      /* Rời trang là gỡ iframe ngay (iOS giữ RAM của trang cũ khá lâu nếu không gỡ) */
      window.addEventListener('pagehide', kill);

      /* Đổi cỡ cửa sổ / xoay điện thoại: gom vào một khung hình */
      function onResize() { if (rafL) return; rafL = requestAnimationFrame(function () { rafL = 0; applyMode(); layout(); }); }
      new ResizeObserver(onResize).observe(stage);
      window.addEventListener('orientationchange', onResize);

      /* ---------- Khởi động ---------- */
      applyMode();
      fill();

      var crashed = false;
      try {
        crashed = !!cur && sessionStorage.getItem('pv:loading') === cur.url;   // lần trước nạp dở mà trang bị kill
        sessionStorage.removeItem('pv:loading');
      } catch (e) {}

      if (!cur) showWait('Không tìm thấy demo · Quay lại', 'back');
      else if (crashed) showWait('Lần trước trang bị dừng đột ngột · Nhấn để tải lại', 'load');
      else requestAnimationFrame(load);
    })();
  </script>
</body>
</html>